@using Microsoft.FluentUI.AspNetCore.Components
@using Refund.Components
@using Refund.Components.IsosurfaceViewer

@implements IAsyncDisposable

@if (_job == null)
{
    <span>No job available to display.</span>
}
else
{
    <div class="postprocess-view-container">
        @{
            string path3dVolume = _job.VisMap3d;
            
            if (!string.IsNullOrWhiteSpace(path3dVolume) && File.Exists(path3dVolume))
            {
                <div style="max-width: 500px; max-height: 500px;">
                    <IsosurfaceViewer MinHeight="500" MinWidth="500" VolumePath="@path3dVolume" />
                </div>
            }
        }
        <!-- Orthoslices in horizontal row -->
        <div class="visualization-section">
            <MapOrthosliceDisplay MapOrthoslicesPath="@_job.VisFilteredSlices"
                                  RenderedImageSidelengthPx="250"
                                  BorderWidthPx="0"
                                  SpacingPx="5"
                                  IsVerticalLayout/>
        </div>

        <!-- FSC, Guinier plots -->
        <div class="visualizations-column">
            <ServerImage ServerPath="@_job.VisFsc"
                         height="300"
                         class="visualization-item"/>

            <ServerImage ServerPath="@_job.VisGuinier"
                         height="300"
                         class="visualization-item"/>
        </div>
    </div>
}