@inherits Refund.Components.Jobs.ExpandedView.LoadingExpandedViewBase
@using Microsoft.FluentUI.AspNetCore.Components
@using Refund.Components
@using Refund.Components.IsosurfaceViewer
@implements IAsyncDisposable

@if (IsInitializing)
{
    <Refund.Components.Jobs.ExpandedView.ExpandedViewLoading />
}
else if (_job == null)
{
    <span>No job available to display.</span>
}
else
{
    <div class="classification-view">
        <FluentButton OnClick="ExportClasses" Disabled="@(!_selectedClasses.Any())" Appearance="ButtonAppearance.Primary">
            Export selection
        </FluentButton>
        <div class="scroll-container">
            @for (int c = 0; c < _job.NClasses; c++)
            {
                int currentClass = c;
                string selectedStyle = _selectedClasses.Contains(c) ? "border-color: var(--colorBrandBackground);" : "";
                <div class="main-frame" style="@selectedStyle" @onclick="() => SetSelected(currentClass)">
                    <div class="class-header">
                        <span>#@(c + 1)</span>
                        @if (_class3DModels is { } stats && stats.Length > c)
                        {
                            <span>@(stats[c].Resolution is { } r ? $"{r:F1} Å" : "?? Å")</span>
                            <span>@(stats[c].Distribution is { } p ? $"{p * 100:F1} %" : "?? %")</span>
                        }
                    </div>
                    @if (File.Exists(_job.VisMap3d(_expandedViewService.CurrentVisIteration, c + 1)))
                    {
                        <div class="map-viewport">
                            <IsosurfaceViewer MinWidth="240" MinHeight="250" MiniMode="true"
                                VolumePath="@_job.VisMap3d(_expandedViewService.CurrentVisIteration, c + 1)" />
                        </div>
                    }
                    <MapOrthosliceDisplay MapOrthoslicesPath="@_job.VisFilteredSlices(_expandedViewService.CurrentVisIteration, c + 1)"
                        RenderedImageSidelengthPx="340" BorderWidthPx="0" SpacingPx="4" IsVerticalLayout />
                    <ServerFigure ServerPath="@_job.VisFsc(_expandedViewService.CurrentVisIteration, c + 1)"
                        Title="Class FSC" ShowTitle="false" MaxWidthEm="23" CacheKey="@_job.UpdateDate.Ticks.ToString()" />
                    <ServerFigure ServerPath="@_job.VisAngularDistribution(_expandedViewService.CurrentVisIteration, c + 1)"
                        Title="Angular distribution" MaxWidthEm="23" CacheKey="@_job.UpdateDate.Ticks.ToString()" />
                    <ServerFigure ServerPath="@_job.VisFourierSampling(_expandedViewService.CurrentVisIteration, c + 1)"
                        Title="Fourier sampling" MaxWidthEm="23" CacheKey="@_job.UpdateDate.Ticks.ToString()" />
                </div>
            }
        </div>
    </div>
}
