@inherits Refund.Components.Jobs.ExpandedView.LoadingExpandedViewBase
@if (IsInitializing)
{
    <Refund.Components.Jobs.ExpandedView.ExpandedViewLoading />
}
else
{
﻿@using Refund.Components.Class2DSelection

@if (_job == null)
{
    <FluentSpinner Size="SpinnerSize.Huge" Style="height: 70px; width: 70px;" />
}
else
{
    <div class="d-flex w-100 justify-content-end position-relative pb-2">
        @if (ShowSubclasses)
        {
            <FluentButton OnClick="SaveSubclassSelection" Appearance="ButtonAppearance.Primary"
                          Disabled="@(!Beam.SubclassSelectionAvailable || _selectedSubclassCount == 0)">Export subclass selection</FluentButton>
        }
        <FluentButton Class="job-card-button job-card-button-accent mr-8"
                      OnClick="@SaveSelectionState"
                      Disabled="@(_nClassesSelected == 0 || !CanExport)"
                      Appearance="ButtonAppearance.Primary">Export selection from final iteration</FluentButton>
    </div>

    @if (Beam != null && !CanExport)
    {
        <p>Class selection becomes available after final particle assignment.</p>
    }
    <Class2DSelection @key="(Beam != null ? ClassStack : null)" @ref="_class2DSelectionComponent"
                      MrcStackPath=@ClassStack
                      ImageNumbers=@_classNumbers
                      ClassIds=@_classIdx
                      ClassResolutions=@_classResolutions
                      ClassSizes=@_classSizes
                      Subclasses=@SubclassData
                      RenderedImageSidelengthPx="128"
                      SpacingPx="6"
                      BorderColorUnselected="transparent"
                      BorderColorSelected="#fd7e14"
                      BorderWidthPx="4"
                      OnSelectionChanged="@SelectionChanged"/>
    @if (ShowSubclasses && !Beam.SubclassSelectionAvailable && !Beam.SubclassesCollectedToCompletion)
    {
        <p>Completed parents appear as they finish. Subclass export becomes available when subclassification finishes or the job is finalized.</p>
    }
    @if (Beam != null && _pcaCount > 0)
    {
        <h4 class="mt-4">Principal components</h4>
        <p>Mean followed by signed components from the latest PCA discovery fit.</p>
        <Class2DSelection @key="Beam.PrincipalComponentsStack(Iteration)"
                          MrcStackPath="@Beam.PrincipalComponentsStack(Iteration)" SignedContrast="true"
                          ImageNumbers="@Enumerable.Range(1, _pcaCount + 1).ToArray()"
                          ClassLabels="@PcaLabels" AllowSorting="false" SelectionIsMutable="false"
                          RenderedImageSidelengthPx="128" SpacingPx="6" BorderColorUnselected="transparent" />
    }
    @if (Beam != null && _embeddingCount > 0)
    {
        <h4 class="mt-4">PCA discovery sample</h4>
        <p>@_embeddingCount.ToString("N0") sampled particles; colors show discovery groups. Up to 20,000 points are plotted.</p>
        <Refund.Components.ServerFigure ServerPath="@Beam.VisEmbeddings(Iteration)" Title="Particle embeddings" ShowTitle="false" MaxWidthEm="32" />
    }

}
}
