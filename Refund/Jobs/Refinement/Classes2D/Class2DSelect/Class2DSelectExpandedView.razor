@inherits Refund.Components.Jobs.ExpandedView.LoadingExpandedViewBase
@if (IsInitializing)
{
    <Refund.Components.Jobs.ExpandedView.ExpandedViewLoading />
}
else
{
﻿@using Refund.Components.Class2DSelection

@if (_job == null || _job.VisAvailableIteration < 0)
{
    <FluentSpinner Size="SpinnerSize.Huge" Style="height: 70px; width: 70px;" />
}
else
{ 
    <h5>Selected:</h5>
    <div>
        <Class2DSelection MrcStackPath=@(_job.ResSelectedClassesFile)
                          ImageNumbers=@(Enumerable.Range(1, _job.SelectedClasses.Length).ToArray())
                          ClassIds=@_selectedClassIdx
                          ClassResolutions=@_selectedClassResolutions
                          ClassSizes=@_selectedClassSizes
                          RenderedImageSidelengthPx="128"
                          SpacingPx="6"
                          BorderColorUnselected="transparent"
                          SelectionIsMutable="false"
                          BorderColorSelected="transparent"
                          BorderWidthPx="0" />
    </div>
    
    <h5 style="margin-top: 30px;">Unselected:</h5>
    <div>
        <Class2DSelection MrcStackPath=@(_job.ResUnselectedClassesFile)
                          ImageNumbers=@(Enumerable.Range(1, _job.UnselectedClasses.Length).ToArray())
                          ClassIds=@_unselectedClassIdx
                          ClassResolutions=@_unselectedClassResolutions
                          ClassSizes=@_unselectedClassSizes
                          RenderedImageSidelengthPx="128"
                          SpacingPx="6"
                          BorderColorUnselected="transparent"
                          SelectionIsMutable="false"
                          BorderColorSelected="transparent"
                          BorderWidthPx="0" />
    </div>
}
}
