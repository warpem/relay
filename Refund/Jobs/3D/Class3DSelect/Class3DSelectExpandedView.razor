@using Refund.Components
@using Refund.Components.IsosurfaceViewer

@implements IAsyncDisposable

@if (_job == null || _job.VisAvailableIteration < 0)
{
    <FluentProgressRing Style="height: 70px; width: 70px;" />
}
else
{
    <div style="width: 100%; overflow: auto; display: flex; flex-direction: column; gap: 1rem;">
        <FluentSwitch @bind-Value="@_isMaskChecked">
            Mask
        </FluentSwitch>
        
        <div style="width: 100%; height: 100%; display: flex; overflow: auto;" class="scroll-container">
            @foreach(int c in _job.SelectedClasses)
            {
                int currentClass = c;
                
                <div style="margin: 0.25rem; height: 100%; padding: 0.5rem;" 
                     class="main-frame">
                        @if (_class3DModels != null && _class3DModels.Any(m => m.Id == currentClass))
                        {
                            var model = _class3DModels.First(m => m.Id == currentClass);
                            
                            <div style="width: 100%; display: flex; justify-content: space-between;">
                                <span>
                                    #@(model.Id)
                                </span>
                                @if (model.Resolution.HasValue)
                                {
                                    <span>@(model.Resolution.Value.ToString("F1")) Å</span>
                                }
                                else
                                {
                                    <span>?? Å</span>
                                }
                                @if (model.Distribution.HasValue)
                                {
                                    <span>@((model.Distribution.Value * 100).ToString("F1")) %</span>
                                }
                                else
                                {
                                    <span>?? %</span>
                                }
                            </div>
                        }
                        @if (File.Exists(_job.VisMap3d(currentClass)))
                        {
                            <div style="max-width: 200px; max-height: 250px; margin-top: 0.3rem;">
                                <IsosurfaceViewer MinWidth="200" MinHeight="250" 
                                                  MiniMode="true"
                                                  VolumePath="@_job.VisMap3d(currentClass)" />
                            </div>
                        }
                        <MapOrthosliceDisplay MapOrthoslicesPath="@(_job.VisFilteredSlices(currentClass))"
                                          RenderedImageSidelengthPx="200"
                                          BorderWidthPx="0"
                                          SpacingPx="5"
                                          IsVerticalLayout/>
                        <div style="display: flex; flex-direction: column; gap: 5px; margin-top: 5px;">
                            <ServerImage ServerPath="@_job.VisFsc(currentClass)" width="200"/>
                            <ServerImage ServerPath="@_job.VisAngularDistribution(currentClass)" width="200"/>
                            <ServerImage ServerPath="@_job.VisFourierSampling(currentClass)" width="200"/>
                        </div>
                    </div>
            }
        </div>
    </div>
}