@using Refund.Components
@using Refund.Components.IsosurfaceViewer

@implements IAsyncDisposable

@if (_job == null)
{
    <span>No job available to display.</span>
}
else
{
    if (_job.VisAvailableIteration >= 0 && File.Exists(_job.VisMap3d))
    {
        <div style="max-width: 500px; max-height: 500px;">
            <IsosurfaceViewer MinHeight="500" MinWidth="500" VolumePath="@_job.VisMap3d"/>
        </div>
    }
}