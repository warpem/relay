@using Refund.Components.ThumbnailPanel
@using Refund.Components.TomogramViewerJs
@using Refund.Components.Histogram

@if (_job == null)
{
    <span>No job to display</span>
}
else if (_allTomogramThumbnails != null && _allTomogramThumbnails.Any())
{
    <div class="container" style="position: relative;">
        @if (_isLoadingAllParticles)
        {
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
                        display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <FluentProgressRing Style="width: 40px; height: 40px;" />
                <div>Loading particle data...</div>
            </div>
        }

        <div class="thumbnail-container">
            <ThumbnailPanel @ref="_tomogramThumbnailPanel"
                           Thumbnails="_allTomogramThumbnails"
                           SelectedThumbnail="_selectedTomogramThumbnail"
                           SelectedThumbnailChanged="SelectedTomogramThumbnailChanged"
                           ShowStatusBar="true"
                           ThumbnailSize="128" />
        </div>

        @if (!_isLoadingAllParticles)
        {
            <div style="height: 100%;">
                <FluentTabs @ref="_tabs" Style="height: 100%;" ActiveTabIdChanged="OnTabIdChanged">
                    
                    <FluentTab Id="@OverviewTabId" Label="Overview" Style="padding-top: 1rem;">
                        <div style="display: grid; grid-template-columns: repeat(2, minmax(350px, 1fr)); gap: 2rem; width: 100%;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                <h6>Correlation score</h6>
                                <Histogram BinSizes="@_histogramBinsScore"
                                           MinRange="@_scoreRange.Min"
                                           MaxRange="@_scoreRange.Max"
                                           RangeSelectionEnabled="false"
                                           Color="#0078D4"
                                           Style="width: 100%; height: 50px;"/>
                            </div>

                            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                <h6>Coordinate X</h6>
                                <Histogram BinSizes="@_histogramBinsCoordX"
                                           MinRange="@_coordXRange.Min"
                                           MaxRange="@_coordXRange.Max"
                                           RangeSelectionEnabled="false"
                                           Color="#0078D4"
                                           Style="width: 100%; height: 50px;"/>
                            </div>

                            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                <h6>Coordinate Y</h6>
                                <Histogram BinSizes="@_histogramBinsCoordY"
                                           MinRange="@_coordYRange.Min"
                                           MaxRange="@_coordYRange.Max"
                                           RangeSelectionEnabled="false"
                                           Color="#0078D4"
                                           Style="width: 100%; height: 50px;"/>
                            </div>

                            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                <h6>Coordinate Z</h6>
                                <Histogram BinSizes="@_histogramBinsCoordZ"
                                           MinRange="@_coordZRange.Min"
                                           MaxRange="@_coordZRange.Max"
                                           RangeSelectionEnabled="false"
                                           Color="#0078D4"
                                           Style="width: 100%; height: 50px;"/>
                            </div>

                            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                <h6>Rotation angle (°)</h6>
                                <Histogram BinSizes="@_histogramBinsAngleX"
                                           MinRange="@_angleXRange.Min"
                                           MaxRange="@_angleXRange.Max"
                                           RangeSelectionEnabled="false"
                                           Color="#0078D4"
                                           Style="width: 100%; height: 50px;"/>
                            </div>

                            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                <h6>Tilt angle (°)</h6>
                                <Histogram BinSizes="@_histogramBinsAngleY"
                                           MinRange="@_angleYRange.Min"
                                           MaxRange="@_angleYRange.Max"
                                           RangeSelectionEnabled="false"
                                           Color="#0078D4"
                                           Style="width: 100%; height: 50px;"/>
                            </div>
                        </div>
                    </FluentTab>

                    <FluentTab Id="@DetailsTabId" Label="Details" Style="height: 100%; padding-top: 1rem;">
                        <div style="display: flex; flex-wrap: nowrap; gap: 2rem; height: 100%; overflow-x: auto;">
                            
                            @if (_selectedTomogramThumbnail != null)
                            {
                                <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                                    <div style="display: flex; flex-direction: column; gap: 1rem; width: 400px;">
                                        <h6>Particle scores</h6>
                                        <Histogram BinSizes="@_selectedHistogramBinsScore"
                                                   MinRange="@_scoreRange.Min"
                                                   MaxRange="@_scoreRange.Max"
                                                   RangeSelectionEnabled="false"
                                                   Color="#0078D4"
                                                   Style="width: 100%; height: 30px;"/>
                                    </div>

                                    <div style="display: flex; flex-direction: column; gap: 1rem; width: 400px;">
                                        <h6>Coordinate X</h6>
                                        <Histogram BinSizes="@_selectedHistogramBinsCoordX"
                                                   MinRange="@_coordXRange.Min"
                                                   MaxRange="@_coordXRange.Max"
                                                   RangeSelectionEnabled="false"
                                                   Color="#0078D4"
                                                   Style="width: 100%; height: 30px;"/>
                                    </div>

                                    <div style="display: flex; flex-direction: column; gap: 1rem; width: 400px;">
                                        <h6>Coordinate Y</h6>
                                        <Histogram BinSizes="@_selectedHistogramBinsCoordY"
                                                   MinRange="@_coordYRange.Min"
                                                   MaxRange="@_coordYRange.Max"
                                                   RangeSelectionEnabled="false"
                                                   Color="#0078D4"
                                                   Style="width: 100%; height: 30px;"/>
                                    </div>

                                    <div style="display: flex; flex-direction: column; gap: 1rem; width: 400px;">
                                        <h6>Coordinate Z</h6>
                                        <Histogram BinSizes="@_selectedHistogramBinsCoordZ"
                                                   MinRange="@_coordZRange.Min"
                                                   MaxRange="@_coordZRange.Max"
                                                   RangeSelectionEnabled="false"
                                                   Color="#0078D4"
                                                   Style="width: 100%; height: 30px;"/>
                                    </div>

                                    <div style="display: flex; flex-direction: column; gap: 1rem; width: 400px;">
                                        <h6>Angle X (Rotation)</h6>
                                        <Histogram BinSizes="@_selectedHistogramBinsAngleX"
                                                   MinRange="@_angleXRange.Min"
                                                   MaxRange="@_angleXRange.Max"
                                                   RangeSelectionEnabled="false"
                                                   Color="#0078D4"
                                                   Style="width: 100%; height: 30px;"/>
                                    </div>

                                    <div style="display: flex; flex-direction: column; gap: 1rem; width: 400px;">
                                        <h6>Angle Y (Tilt)</h6>
                                        <Histogram BinSizes="@_selectedHistogramBinsAngleY"
                                                   MinRange="@_angleYRange.Min"
                                                   MaxRange="@_angleYRange.Max"
                                                   RangeSelectionEnabled="false"
                                                   Color="#0078D4"
                                                   Style="width: 100%; height: 30px;"/>
                                    </div>
                                </div>
                            }

                            <div class="tomogram-viewer-container" style="width: 100%; height: 100%;">
                                @if (_selectedTomogramPath != null)
                                {
                                    <TomogramViewerJs TomogramPath="@_selectedTomogramPath"
                                                      Species="@_viewerSpecies"
                                                      MinWidth="512"
                                                      MinHeight="768"/>
                                }
                                else
                                {
                                    <div class="no-selection-message">
                                        <span>Select a tomogram to view</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </FluentTab>
                </FluentTabs>
            </div>
        }
    </div>
}