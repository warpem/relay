@using Refund.Components.ThumbnailPanel
@using Refund.Components.MicrographViewer
@using Refund.Components.FourierSpace
@using Refund.Components.SingleAxisScatter
@using Refund.Components.Jobs
@using Refund.Components
@using Warp.Tools

@if (_job == null)
{
    <span>No job to display</span>
}
else if (_allTsThumbnails != null && _allTsThumbnails.Any())
{
    <div class="container" style="height: 100%;">
        <div style="display: flex; flex-direction: column; gap: 0.0rem;">
            <ThumbnailPanel @ref="_tsThumbnailPanel"
                            Thumbnails="_allTsThumbnails"
                            SelectedThumbnailChanged="SelectedTsThumbnailChanged"
                            ShowStatusBar="true"
                            ThumbnailSize="128"
                            CheckMode="CheckMode.Binary"
                            ThumbnailCheckChanged="TsThumbnailCheckChanged" />

            @if (_selectedTsItem != null)
            {
                <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                    <h6>Tilt images in @_selectedTsItem.Path:</h6>

                    <ThumbnailPanel @ref="_fsThumbnailPanel"
                                    Thumbnails="_allFsThumbnails"
                                    SelectedThumbnailChanged="SelectedFsThumbnailChanged"
                                    ShowStatusBar="true"
                                    ThumbnailSize="128"
                                    CheckMode="CheckMode.Binary"
                                    ThumbnailCheckChanged="FsThumbnailCheckChanged" />
                </div>
            }
        </div>

        <div style="position: relative; height: 100%;">

            <div style="position: absolute; top: -0.75rem; right: 0">
                
                @if (_job.FurtherDeselectedTiltSeries.Any() || _job.FurtherDeselectedTilts.Any())
                {
                    <div style="display: flex; gap: 0.5rem;">
                        @if (_job.DeselectedTiltSeries.Any())
                        {
                            <ConfirmButton Color="var(--error)"
                                           Position="ConfirmationPosition.Bottom"
                                           OnClick="ClearAllDeselectedTiltSeries" >
                                Clear all tilt-series deselections
                            </ConfirmButton>
                        }
                        
                        @if (_job.DeselectedTilts.Any())
                        {
                            <ConfirmButton Color="var(--error)"
                                           Position="ConfirmationPosition.Bottom"
                                           OnClick="ClearAllDeselectedTilts" >
                                Clear all tilt deselections
                            </ConfirmButton>
                        }
                        
                        @if (_selectedTsItem != null && _selectedTsItem.TiltMoviePaths.Select(p => Helper.PathToName(p))
                                                                       .Any(p => _job.DeselectedTilts.Contains(p)))
                        {
                            <ConfirmButton Color="var(--error)"
                                           Position="ConfirmationPosition.Bottom"
                                           OnClick="ClearDeselectedTilts" >
                                Clear all tilt deselections in this series
                            </ConfirmButton>
                        }
                        
                        <FluentButton Appearance="Appearance.Accent"
                                      OnClick="ExportSelection">
                            Export selection
                        </FluentButton>
                    </div>
                }
                
                <TsMiniItem ThumbnailSize="96" GetThumbnail="@(path => _micrographs.ToThumbnailPath(path))"/>
                <FsMiniItem ThumbnailSize="96" GetThumbnail="@(path => _micrographs.ToThumbnailPath(path))"/>
            </div>

            <FluentTabs @ref="_tabs"
                        Style="height: 100%;">
                <FluentTab Id="@OverviewTabId"
                           Label="Overview"
                           Style="padding-top: 1rem;">
                    <div style="display: flex; flex-direction: column; gap: 2rem;">

                        <div style="display: flex; flex-direction: column; gap: 1rem;">
                            <h6>Number of tilts</h6>
                            <SingleAxisScatter Points="@_pointsTsNTilts"
                                               PointClicked="@HandleTsPointClicked"
                                               Style="width: 100%; height: 80px;"/>
                        </div>
                    </div>
                </FluentTab>

                <FluentTab Id="@TsTabId"
                           Label="Tilt series details" 
                           Style="height: 100%; padding-top: 1rem;">
                    @if (_selectedTsThumbnail != null)
                    {
                        <div style="display: flex; flex-wrap: nowrap; gap: 2rem; height: 100%;">
                            
                            <div style="display: flex; flex-direction: column; gap: 1.5rem; width: 400px;">
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <h6>Tilt angle (°)</h6>
                                    <SingleAxisScatter Points="@_pointsFsTiltAngle"
                                                       PointClicked="@HandleFsPointClicked"
                                                       Style="width: 100%; height: 80px;"/>
                                </div>

                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <h6>Accumulated exposure (e⁻/Å²)</h6>
                                    <SingleAxisScatter Points="@_pointsFsExposure"
                                                       PointClicked="@HandleFsPointClicked"
                                                       Style="width: 100%; height: 80px;"/>
                                </div>

                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <h6>Median image intensity relative to series maximum (%)</h6>
                                    <SingleAxisScatter Points="@_pointsFsIntensity"
                                                       PointClicked="@HandleFsPointClicked"
                                                       Style="width: 100%; height: 80px;"/>
                                </div>

                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <h6>Defocus (µm)</h6>
                                    <SingleAxisScatter Points="@_pointsFsDefocus"
                                                       PointClicked="@HandleFsPointClicked"
                                                       Style="width: 100%; height: 80px;"/>
                                </div>

                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <h6>CTF fit resolution (Å)</h6>
                                    <SingleAxisScatter Points="@_pointsFsCtfRes"
                                                       PointClicked="@HandleFsPointClicked"
                                                       Style="width: 100%; height: 80px;"/>
                                </div>

                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <h6>Average frame motion in first ⅓ of exposure (Å)</h6>
                                    <SingleAxisScatter Points="@_pointsFsMotion"
                                                       PointClicked="@HandleFsPointClicked"
                                                       Style="width: 100%; height: 80px;"/>
                                </div>
                            </div>
                            
                            <div class="visualization-container" style="width: 100%; height: 100%;">

                                <MicrographViewer MinWidth="512"
                                                  MinHeight="512"
                                                  MicrographPath="@(_micrographs.ToAveragePath(_selectedTsItem.TiltMoviePaths[_selectedTsItem.TiltMoviePaths.Length / 2]))"
                                                  ThumbnailPath="@(_selectedTsThumbnail.ImagePath)"/>
                            </div>
                        </div>
                    }
                </FluentTab>

                <FluentTab Id="@FsTabId"
                           Label="Tilt movie details"
                           Style="height: 100%;">
                    @if (_selectedFsThumbnail != null)
                    {
                        <div class="visualization-container" style="width: 100%; height: 100%;">
                            <MicrographViewer MinWidth="512"
                                              MinHeight="512"
                                              MicrographPath="@(_micrographs.ToAveragePath(_selectedFsItem.Path))"
                                              ThumbnailPath="@(_micrographs.ToThumbnailPath(_selectedFsItem.Path))"/>
                        </div>
                    }
                </FluentTab>
            </FluentTabs>
        </div>
    </div>
}