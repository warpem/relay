@inherits Refund.Components.Jobs.ExpandedView.LoadingExpandedViewBase
@using Microsoft.FluentUI.AspNetCore.Components
@using Refund.Components
@using Refund.Components.ThumbnailPanel
@using Refund.Components.MicrographViewer

@if (IsInitializing)
{
    <Refund.Components.Jobs.ExpandedView.ExpandedViewLoading />
}
else if (_job == null)
{
    <FluentSpinner Size="SpinnerSize.Huge" Style="height: 70px; width: 70px;"/>
}
else if (_allThumbnails != null && _allThumbnails.Any())
{
    <div class="container">
        <ThumbnailPanel 
            Thumbnails="_allThumbnails"
            SelectedThumbnailChanged="SelectedThumbnailChanged"
            ShowStatusBar="true"
            ThumbnailSize="128" />

        @if (_selectedThumbnail != null)
        {
            <div class="viewer-container">
                <MicrographViewer MinWidth="768"
                                  MinHeight="768"
                                  MicrographPath="@(_job.ResAverageFile(_selectedName))"
                                  ThumbnailPath="@(_job.VisThumbnail(_selectedName))"
                                  ParticleStarPath="@(_job.ResParticlesStar(_selectedName))"
                                  CanEditMask="false"
                                  DefaultParticleDiameter="(double)_job.Diameter"
                                  DefaultParticleBoxSize="(double)_job.BoxSize"
                                  CanEditParticles="false" />
            </div>
        }
    </div>
}
