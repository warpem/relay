@using Refund.Services.Warp
@using Microsoft.JSInterop
@using Refund.Components.MicrographViewer
@using Refund.Components.FourierSpace
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div class="evidence monitor">
    <div class="exposure-heading">
        <span class="exposure-number"><b>#@((Movie.Index + 1).ToString("N0"))</b></span>
        <span class="file-name" title="@Movie.Name">@Movie.Name</span>
        <span class="status-chip exposure-state"><i style="background:@Session.StatusColor(Movie)"></i>@Session.Status(Movie)</span>
        <span class="exposure-navigation">
            <FluentButton Title="Previous exposure" Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Filled.Size16.ChevronLeft())" OnClick="@(() => Select(Movie.Index - 1))" Disabled="@(Movie.Index == 0)" />
            <FluentButton Title="Next exposure" Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Filled.Size16.ChevronRight())" OnClick="@(() => Select(Movie.Index + 1))" Disabled="@(Movie.Index == Session.Movies.Count - 1)" />
        </span>
        @if (FollowChanged.HasDelegate) { <FluentSwitch Class="follow-latest" Value="Follow" ValueChanged="@((bool v) => FollowChanged.InvokeAsync(v))" Label="Follow latest" title="Show each new result as it arrives" /> }
    </div>
    <div class="evidence-controls">
        <div class="view-modes segmented" role="group" aria-label="Micrograph"><FluentButton Class="@(!ShowEnhanced ? "selected" : null)" Appearance="ButtonAppearance.Subtle" OnClick="@(() => _enhanced = false)">Average</FluentButton><FluentButton Class="@(ShowEnhanced ? "selected" : null)" Appearance="ButtonAppearance.Subtle" Disabled="@(!Movie.Done.HasFlag(WarpStage.Enhance))" OnClick="@(() => _enhanced = true)" Title="Deconvolved and, when available, denoised">@DenoisedLabel</FluentButton></div>
        <span class="spacer"></span>
        <span class="segmented-label" id="@_selectionLabel">Selection</span>
        <div class="disposition-controls segmented" role="group" aria-labelledby="@_selectionLabel"><FluentButton Class="@DispositionClass(WarpDisposition.Auto)" Appearance="ButtonAppearance.Subtle" Title="Accept or reject by the filter ranges" OnClick="@(() => SetDisposition(WarpDisposition.Auto))">Use filters</FluentButton><FluentButton Class="@DispositionClass(WarpDisposition.Keep)" Appearance="ButtonAppearance.Subtle" Title="Keep regardless of filters" OnClick="@(() => SetDisposition(WarpDisposition.Keep))">Keep</FluentButton><FluentButton Class="@DispositionClass(WarpDisposition.Exclude)" Appearance="ButtonAppearance.Subtle" Title="Exclude regardless of filters" OnClick="@(() => SetDisposition(WarpDisposition.Exclude))">Exclude</FluentButton></div>
    </div>
    @if (Movie.Failed && !string.IsNullOrWhiteSpace(Movie.Error)) { <div class="movie-error" role="alert">@Movie.Error</div> }
    <dl class="readings">
        <div><dt>Motion</dt><dd>@Value(Movie.Motion, WarpStage.Motion) <span>Å/frame</span></dd></div>
        <div><dt>CTF fit</dt><dd>@Value(Movie.Ctf, WarpStage.Ctf) <span>Å</span></dd></div>
        <div><dt>Defocus</dt><dd>@Value(Movie.Defocus, WarpStage.Ctf) <span>µm</span></dd></div>
        <div><dt>Astigmatism</dt><dd>@Value(Movie.Astigmatism, WarpStage.Ctf, "F3") <span>µm</span></dd></div>
        <div><dt>Angle</dt><dd>@Value(Movie.AstigmatismAngle, WarpStage.Ctf, "F0")<span>°</span></dd></div>
        <div><dt>Ice</dt><dd>@Value(Movie.Ice, WarpStage.Ctf, "F0") <span>Å</span></dd></div>
        <div><dt>Particles</dt><dd>@(Movie.Done.HasFlag(WarpStage.Pick) ? Movie.Picks.ToString("N0") : "—")</dd></div>
    </dl>
    <div class="diagnostic-grid">
        <figure class="micrograph-evidence">
            <div class="micrograph-square image-well">@if (Movie.Done.HasFlag(WarpStage.Motion) && !string.IsNullOrEmpty(Movie.AveragePath)) { <MicrographViewer @key="Movie.Id" MicrographPath="@(ShowEnhanced ? Movie.EnhancedPath : Movie.AveragePath)" ResultRevision="@(ShowEnhanced ? Movie.ResultRevision : Movie.MotionRevision)" ThumbnailPath="@Movie.ThumbnailPath" MinWidth="200" MinHeight="200" CanEditParticles="false" CanEditMask="false" /> } else { <div class="empty-evidence">Waiting for motion correction</div> }</div>
        </figure>
        <figure class="fourier-evidence">
            @if (Movie.Done.HasFlag(WarpStage.Ctf) && !string.IsNullOrEmpty(Movie.MetadataPath)) { <div class="real-spectrum"><div class="spectrum-key" aria-hidden="true"><span class="measured">Measured</span><span class="fitted">Fitted</span><span class="quality">Fit quality</span></div><AmplitudeSpectrumViewer @key="Movie.Id" ResultRevision="Movie.CtfRevision" MovieFilePath="@Movie.MetadataPath" FittingRangeMin="Session.Settings.CtfMin" FittingRangeMax="Session.Settings.CtfMax" /></div> } else { <div class="spectrum-placeholder image-well"><div class="empty-evidence">Waiting for CTF estimation</div></div> }
        </figure>
    </div>
</div>

@code {
    [Parameter] public WarpSession Session { get; set; }
    [Parameter, EditorRequired] public Func<Action<WarpSession>, Task> Update { get; set; }
    [Parameter] public WarpMovie Movie { get; set; }
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
    [Parameter] public bool Follow { get; set; }
    [Parameter] public EventCallback<bool> FollowChanged { get; set; }
    private bool _enhanced;
    // Enhancement always deconvolves; it denoises only when the denoiser is enabled in Setup.
    private string DenoisedLabel => Session.Settings.Denoise ? "Denoised" : "Deconvolved";
    private bool ShowEnhanced => _enhanced && Movie.Done.HasFlag(WarpStage.Enhance) && !string.IsNullOrEmpty(Movie.EnhancedPath);
    private string Value(double value, WarpStage stage, string format = "F2") => Movie.Done.HasFlag(stage) && double.IsFinite(value) ? value.ToString(format) : "—";
    private readonly string _selectionLabel = $"warp-selection-{Guid.NewGuid():N}";
    private string DispositionClass(WarpDisposition disposition) => Movie.Disposition == disposition ? "selected" : null;
    private Task SetDisposition(WarpDisposition disposition) => Update(s => s.SetDisposition([Movie.Index], disposition));
    private Task Select(int index) => SelectedIndexChanged.InvokeAsync(Math.Clamp(index, 0, Session.Movies.Count - 1));
}
