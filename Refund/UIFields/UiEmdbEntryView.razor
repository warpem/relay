@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.FluentUI.AspNetCore.Components
@using System.Net.Http
@using Microsoft.Extensions.Logging
@inject ILogger<UiEmdbEntryView> Logger
@implements  IDisposable
@inherits UiFieldViewBase

<div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <RobustFluentNumberField
                       TValue="@(int?)"
                       Class="borderless"
                       Value="@ValueT"
                       Style="width: 100%"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="1"
                       ValueChanged="@OnInputChanged"
                       Disabled="@IsDisabled"/>
    
    @if (_isValid && !string.IsNullOrEmpty(_previewUrl))
    {   
        <img src="@_previewUrl" alt="EMDB Entry Preview" style="max-height: 128px; max-width: 100%; object-fit: contain;" />
    }
</div>

@code {
    private string _previewUrl;
    private bool _isValid;
    /// <summary>Cancels the pending or running lookup when the value changes again or the field goes away.</summary>
    private CancellationTokenSource _debounce;
    private static readonly HttpClient HttpClient = new HttpClient { Timeout = TimeSpan.FromSeconds(15) };
    
    private UiEmdbEntry FieldDescriptionT => (UiEmdbEntry)FieldDescription ?? null;

    private int? ValueT => (int?)EditingValue;

    private Task SetValueTAsync(int? value) => SetValueAsync(value);

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (ValueT != null && ValueT.Value > 0)
            // Check initial value on component init
            ScheduleCheck();
    }

    private async Task OnInputChanged(int? value)
    {
        await SetValueTAsync(value);

        // Reset preview state
        _previewUrl = null;
        _isValid = false;

        ScheduleCheck();
    }

    /// <summary>
    /// Debounces the EMDB lookup. This used to be a System.Timers.Timer whose async void Elapsed handler ran on
    /// the thread pool, where any exception would take down the whole server process. The task runs on the
    /// renderer's synchronization context and observes all of its own exceptions.
    /// </summary>
    private void ScheduleCheck()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        _ = DebouncedCheckAsync(_debounce.Token);
    }

    private async Task DebouncedCheckAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(500, cancellationToken);
            await CheckEmdbEntry(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exc)
        {
            Logger.LogWarning(exc, "EMDB entry lookup failed");
        }
    }

    private async Task CheckEmdbEntry(CancellationToken cancellationToken)
    {
        if (ValueT is not > 0)
        {
            // Invalid or empty value
            _previewUrl = null;
            _isValid = false;
            StateHasChanged();
            return;
        }

        _isValid = false;
        StateHasChanged();

        string paddedId = ValueT.Value.ToString("D4");
        string previewUrl = $"https://www.ebi.ac.uk/emdb/images/entry/EMD-{paddedId}/400_{paddedId}.gif";
        _previewUrl = previewUrl;

        bool isValid;
        try
        {
            // Check if entry exists by trying to fetch the preview image
            using var request = new HttpRequestMessage(HttpMethod.Head, previewUrl);
            using var response = await HttpClient.SendAsync(request, cancellationToken);
            isValid = response.IsSuccessStatusCode;
        }
        catch (Exception) when (!cancellationToken.IsCancellationRequested)
        {
            isValid = false;
        }

        // A newer value has superseded this lookup; its own check will update the preview.
        cancellationToken.ThrowIfCancellationRequested();

        _isValid = isValid;
        StateHasChanged();
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = null;
        base.Dispose();
    }
}
