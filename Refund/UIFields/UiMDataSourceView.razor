@namespace Refund.UIFields
@using Accord.Math
@using Refund.JobResources
@inherits UiFieldViewBase

@if (AdditionalData is List<MDataSource> { Count: > 0 } sources)
{
    <FluentRadioGroup TValue="int?" Class="borderless"
                      @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
                      Orientation="Orientation.Vertical"
                      Disabled="@IsDisabled">
        @foreach (var source in sources)
        {
            <FluentRadio TValue="int?" Value="@sources.IndexOf(source)" Label="@source.Name" />
        }
    </FluentRadioGroup>
}
else
{
    <span class="text-muted">No data sources available</span>
}

@code
{
    private int? ValueT => (int?)EditingValue;

    private Task SetValueTAsync(int? value) => SetValueAsync(value);
}