@namespace Refund.UIFields
@using System.Globalization
@using Warp.Tools
@inherits UiFieldViewBase

<FluentStack>
    <RobustFluentNumberField @bind-Value="@ValueXT" Style="width: 33%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))"
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value="@ValueYT" Style="width: 33%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))"
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value="@ValueZT" Style="width: 34%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))" 
                       Disabled="@IsDisabled" />
</FluentStack>

@code
{
    private UiFloat3 FieldDescriptionT => (UiFloat3)FieldDescription ?? null;

    private float ValueXT
    {
        get => ((float3)Value).X;
        set => ValueChanged.InvokeAsync(new float3(value, ((float3)Value).Y, ((float3)Value).Z));
    }

    private float ValueYT
    {
        get => ((float3)Value).Y;
        set => ValueChanged.InvokeAsync(new float3(((float3)Value).X, value, ((float3)Value).Z));
    }

    private float ValueZT
    {
        get => ((float3)Value).Z;
        set => ValueChanged.InvokeAsync(new float3(((float3)Value).X, ((float3)Value).Y, value));
    }

    private string StepSizeToFormat(float stepSize)
    {
        var logStep = -(int)Math.Min(Math.Floor(Math.Log10((double)stepSize) + 1e-6), 0);

        return $"F{logStep}";
    }
}
