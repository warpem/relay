@using Refund.Services.Core.DataManager
@namespace Refund.UIFields
@inherits UiFieldViewBase
@inject DataManager DataManager

<FluentSelect Class="borderless"
              @bind-Value="@ValueT"
              Width="100%"
              Items="@Options"
              OptionText="@(o => o.Text)"
              OptionValue="@(o => o.Value)"
              OptionSelected="@(o => o.Selected)"
              Disabled="@IsDisabled" />

@code
{
    private int CurrentId => Value is int i ? i : -1;

    private string? ValueT
    {
        get => CurrentId.ToString();
        set => ValueChanged.InvokeAsync(value != null ? int.Parse(value) : -1);
    }

    private List<Option<string>> Options
    {
        get
        {
            var current = CurrentId;
            var options = new List<Option<string>>
            {
                new() { Value = "-1", Text = "Local (no pool)", Selected = current == -1 }
            };

            options.AddRange(DataManager.ClusterQueues.Select(q => new Option<string>
            {
                Value    = q.Id.ToString(),
                Text     = string.IsNullOrWhiteSpace(q.Alias) ? $"Queue {q.Id}" : q.Alias,
                Selected = q.Id == current,
            }));

            return options;
        }
    }
}
