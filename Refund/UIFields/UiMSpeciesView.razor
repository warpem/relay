@using Refund.JobResources
@inherits UiFieldViewBase

@if (AdditionalData is List<MSpecies> { Count: > 0 } species)
{
    <FluentRadioGroup TValue="int?" Class="borderless"
                      @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
                      Orientation="Orientation.Vertical"
                      Disabled="@IsDisabled">
        @foreach (var s in species)
        {
            <FluentRadio TValue="int?" Value="@species.IndexOf(s)" Label="@s.Name" />
        }
    </FluentRadioGroup>
}
else
{
    <span class="text-muted">No species available</span>
}

@code
{
    private int? ValueT => (int?)EditingValue;

    private Task SetValueTAsync(int? value) => SetValueAsync(value);
}