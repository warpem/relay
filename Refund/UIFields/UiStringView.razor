@namespace Refund.UIFields
@inherits UiFieldViewBase

<FluentTextField Class="borderless" 
                 @bind-Value="@ValueT"
                 Style="width: 100%"
                 Placeholder="No value"
                 Immediate="true"
                 Disabled="@IsDisabled" />

@code
{
    private UiString FieldDescriptionT => (UiString)FieldDescription ?? null;

    private string ValueT
    {
        get => (string)Value;
        set => ValueChanged.InvokeAsync(value);
    }
}
