@namespace Refund.UIFields
@inherits UiFieldViewBase

<FluentSelect TOption="SelectOption<string>" TValue="string" @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
              Class="borderless" Appearance="ListAppearance.Transparent"
              Width="100%"
              Items="@Options"
              OptionText="@(i => i.Text)"
              OptionValue="@(i => i.Value)"
              Disabled="@IsDisabled"/>

@code
{
    private UiEnum FieldDescriptionT => (UiEnum)FieldDescription ?? null;

    private string ValueT => EditingValue.ToString();

    private Task SetValueTAsync(string value) => SetValueAsync(Enum.Parse(FieldDescriptionT.EnumType, value));

    private List<SelectOption<string>> Options => FieldDescriptionT.EnumType.GetEnumNames().Select(e => new SelectOption<string>() { Value = e, Text = FieldDescriptionT.GetOptionLabel(e) }).ToList();
}
