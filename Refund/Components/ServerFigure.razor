@using Refund.Services
@inject FileService FileService

<figure class="theme-figure" style="max-width: @(MaxWidthEm.ToString(System.Globalization.CultureInfo.InvariantCulture))em">
    @if (ShowTitle)
    {
        <figcaption>@Title</figcaption>
    }
    @if (_imagePath != null)
    {
        <img src="@Url(_imagePath)" alt="@Title" />
    }
    else
    {
        <p class="figure-unavailable">Figure not available for this iteration.</p>
    }
</figure>

@code {
    [Parameter, EditorRequired] public string ServerPath { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; }
    [Parameter] public string CacheKey { get; set; }

    private string _imagePath;
    // 10-point chart text becomes 1em at this width (figure inches * 72 / 10).
    [Parameter] public double MaxWidthEm { get; set; } = 46.08;
    [Parameter] public bool ShowTitle { get; set; } = true;

    protected override void OnParametersSet()
    {
        _imagePath = null;
        if (string.IsNullOrWhiteSpace(ServerPath)) return;
        string svg = System.IO.Path.ChangeExtension(ServerPath, ".svg");
        if (File.Exists(svg)) _imagePath = svg;
        else if (File.Exists(ServerPath)) _imagePath = ServerPath;

    }

    private string Url(string path) => FileService.GetUrl(path) +
        (string.IsNullOrWhiteSpace(CacheKey) ? "" : $"?v={Uri.EscapeDataString(CacheKey)}");
}
