<div @ref="_root" id="class2d-images-@guid" style="display: flex; flex-direction: column; align-items: start;">
    <div data-image-status role="status" aria-live="polite"></div>
    @if (_interopError != null)
    {
        <p>Unable to load class images: @_interopError</p>
    }
    @if (AllowSorting)
    {
        <div class="toolbar">
            <FluentSelect TOption="SelectOption<string>" TValue="SelectOption<string>" Items="@SortOptions"
                          Multiple="false"
                          Width="160px"
                          OptionText="@(i => i.Text)"
                          OptionValue="@(i => i)"
                          Value="@SelectedSortOption"
                          ValueChanged="@(EventCallback.Factory.Create<SelectOption<string>?>(this, OnSortOptionChanged))"/>
            <FluentButton Title="Switch sort direction" OnClick="ToggleSortDirection" IconEnd="@IconSort"/>
        </div>
    }
    @if (ImageNumbers != null)
    {
        <div class="class2d-image-grid-@(guid)">
            @foreach (var i in ClassOrderSorted())
            {
                int c = ImageNumbers[i];
            
                <div @key="c" class="class2d-image-container-@(guid)">
                    <img class="class2d-image-tile-@(guid)" data-image-index="@(c - 1)" alt="Class image @c" />
                    <div class="border-overlay-@(guid) @(selectedClasses.Contains(c) ? "selected" : "")"
                         @onclick="() => ToggleSelection(c)">
                    </div>
                    @if (ClassIds != null || ClassLabels != null)
                    {
                        <span style="position: absolute; left: 7px; top: 3px; color: white;">
                            @(ClassLabels != null ? ClassLabels[i] : $"#{ClassIds[i]}")
                        </span>
                    }
                    @if (ClassResolutions != null)
                    {
                        <span style="position: absolute; right: 7px; top: 3px; color: white;">
                            @ClassResolutions[i].ToString("F0") Å
                        </span>
                    }
                    @if (ClassSizes != null)
                    {
                        <span style="position: absolute; left: 7px; bottom: 3px; color: white;">
                            @((ClassSizes[i] * 100).ToString("F1")) %
                        </span>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .toolbar {
        display: flex;
        justify-content: space-between;
        padding-top: 5px;
        padding-bottom: 5px;
    }
    
    .class2d-image-grid-@(guid) {
        display: flex;
        flex-wrap: wrap;
    }

    .class2d-image-container-@(guid) {
        position: relative;
        margin: @($"{SpacingPx / 2}px");
        width: @($"{RenderedImageSidelengthPx}px");
        height: @($"{RenderedImageSidelengthPx}px");
        border-radius: 10px;
    }

    .class2d-image-tile-@(guid) {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        border-radius: 10px;
    }

    .class2d-image-tile-@(guid):not([src]) { visibility: hidden; }

    .border-overlay-@(guid) {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: solid;
        border-width: @($"{BorderWidthPx}px");
        border-color: @(BorderColorUnselected);
        border-radius: 10px;
        box-sizing: border-box;
    }

    .border-overlay-@(guid).selected {
        border-color: @(BorderColorSelected);
    }
</style>


@if(SelectionIsMutable)
{
    <style>
        .class2d-image-container-@(guid):hover {
            box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
        }
    </style>
}
