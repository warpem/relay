@using Refund.Services

<img src="@ImageUrl()" @attributes="AdditionalAttributes" />

@code
{
    private string ImageUrl()
    {
        var url = FileService.GetUrl(ServerPath);
        return string.IsNullOrWhiteSpace(CacheKey)
            ? url
            : $"{url}?v={Uri.EscapeDataString(CacheKey)}";
    }
}
