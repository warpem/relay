@using Microsoft.JSInterop
@using Microsoft.FluentUI.AspNetCore.Components
@inject IJSRuntime JsRuntime

<div class="container @(_isLoading ? "loading" : "")">
    @if (_isLoading)
    {
        <div class="loading-overlay">
            <FluentSpinner Size="SpinnerSize.Huge" Style="width: 70px; height: 70px;" />
        </div>
    }
    else
    {
        @if (IsTiltSeriesMode && _tiltAngles.Length > 0)
        {
            <div class="tilt-slider-container">
                <div>Current tilt: @_tiltAngles[_currentTiltIndex].ToString("F1") °</div>
                <FluentSlider TValue="int"
                              Min="0"
                              Max="@(Math.Max(0, _tiltCount - 1))"
                              Step="1"
                              Value="@_currentTiltIndex"
                              ValueChanged="HandleTiltIndexChanged" />
                <div class="slider-labels">
                    <span>
                        @_tiltAngles.First().ToString("F1") °
                    </span>
                    <span>
                        @_tiltAngles[_zeroTiltIndex].ToString("F1") °
                    </span>
                    <span>
                        @_tiltAngles.Last().ToString("F1") °
                    </span>
                </div>
            </div>
        }

        @if (_specimenThicknessAngstrom.HasValue)
        {
            <div>Estimated sample thickness: @_specimenThicknessAngstrom.Value.ToString("F0") Å</div>
        }

        <div class="chart-container" style="opacity: @(_isLoading ? "0" : "1")">
            <canvas @ref="_canvasReference"
                    class="chart"
                    style="width: 512px; aspect-ratio: 2/1;"
                    width="512">
            </canvas>

            <div class="custom-tooltip" style="opacity: 0">
                <div class="tooltip-title"></div>
                <table>
                    <tbody>
                    <tr>
                        <td>
                            <span class="custom-tooltip-bullet" style="background: rgb(0, 191, 255)"></span>
                            Experimental
                        </td>
                        <td class="experimental-value"></td>
                    </tr>
                    <tr>
                        <td>
                            <span class="custom-tooltip-bullet" style="background: rgb(255, 20, 147)"></span>
                            Fitted
                        </td>
                        <td class="fitted-value"></td>
                    </tr>
                    <tr class="quality-row" hidden>
                        <td>
                            <span class="custom-tooltip-bullet" style="background: rgb(211, 211, 211)"></span>
                            Quality
                        </td>
                        <td class="quality-value"></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* Drawn by renderSpectrum, which reveals it once the plane has loaded. *@
        <canvas @ref="_spectrumCanvas"
                class="power-spectrum"
                style="width: 512px; height: 512px; opacity: 0"
                role="img"
                aria-label="Power spectrum"></canvas>
    }
</div>
