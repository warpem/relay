@using Microsoft.FluentUI.AspNetCore.Components

<div class="file-browser"
     style="@($"height: {Height}px;")">

    <FluentInputFile @ref="@fileUploader"
                     AnchorId="@ControlId("buttonUpload")"
                     DragDropZoneVisible="false"
                     Mode="InputFileMode.Buffer"
                     Multiple="true"
                     MaximumFileSize="@((long)1 << 31)"
                     BufferSize="@(1 << 20)"
                     OnProgressChange="@OnFileUploadProgressChange"
                     OnCompleted="@OnFileUploadCompleted" />

    <!-- Address Bar -->
    <div class="address-bar">
        <span class="non-editable-part">@TopLevelFolderLabel</span>
        <RelayTextInput Value="@EditableAddress"
                         Placeholder="Enter path"
                         ValueChanged="@HandleAddressBarKeyDown"
                         Style="flex: 1;" />
    </div>

    <!-- Top Toolbar -->
    <div class="toolbar">

        <div class="toolbar-left">
            <FluentButton Id="@ControlId("buttonCreateFolder")" Title="Create folder" IconEnd="@IconCreateFolder" OnClick="CreateFolderAsync" Disabled="@(!IsCurrentFolderWritable)" />
            <FluentButton Id="@ControlId("buttonUpload")" Title="Upload file" Style="margin-left: 4px;" IconEnd="@IconUploadFile" OnClick="StartFileUpload" Disabled="@(!IsCurrentFolderWritable || filesBeingUploaded.Any())" />
            <FluentButton Id="@ControlId("buttonRename")" Title="Rename" Style="margin-left: 10px;" IconEnd="@IconRename" OnClick="RenameItem" Disabled="@(!CanRenameItem)" />
            <FluentButton Id="@ControlId("buttonDelete")" Title="Delete" Style="margin-left: 4px;" IconEnd="@IconDelete" OnClick="ShowDeleteConfirmation" Disabled="@(!CanDeleteItem)" />
        </div>

        <div class="toolbar-right">
            <ToggleButton @bind-IsToggled="ShowHiddenFiles" Icon="@IconShowHiddenFiles"
                          Title="Show hidden files" Style="margin-right: 10px;" />

            <FluentSelect TOption="SelectOption<string>" TValue="SelectOption<string>" Items="@SortOptions"
                          Multiple="false"
                          Width="160px"
                          OptionText="@(i => i.Text)"
                          OptionValue="@(i => i)"
                          Value="@SelectedSortOption"
                          ValueChanged="@(EventCallback.Factory.Create<SelectOption<string>?>(this, OnSortOptionChanged))" />
            <FluentButton Title="Switch sort direction" OnClick="ToggleSortDirection" IconEnd="@IconSort" />
        </div>
    </div>

    <!-- Columns Container -->
    @if (EditorError != null)
    {
        <div class="error-message" role="alert">@EditorError</div>
    }
    <div class="columns-container" @ref="columnsContainer">
        @for (int i = 0; i < FolderLevels.Count; i++)
        {
            var level = FolderLevels[i];
            var isLastColumn = i == FolderLevels.Count - 1;
            var showFilesInThisColumn = ShowFilesInBrowser || (SelectionMode == SelectionMode.SingleFolder && isLastColumn);
            var filesAreSelectable = SelectionMode != SelectionMode.SingleFolder;

            <FolderColumn Path="@level.Path"
                          LevelIndex="@i"
                          OnItemSelected="@OnItemSelectedAsync"
                          SelectedItem="@level.SelectedItem"
                          SelectedItems="@SelectedItems"
                          ShowFiles="@showFilesInThisColumn"
                          FilesAreSelectable="@filesAreSelectable"
                          ShowFolders="true"
                          ShowHiddenItems="@ShowHiddenFiles"
                          AllowedExtensions="@AllowedExtensions"
                          SortOption="@SortOption"
                          IsAscending="@SortIsAscending"
                          @key="@($"{level.Path}, {level.RefreshTrigger}")" />
        }
        @if (SelectedItems.Any() && SelectedItems.Any(item => !item.IsDirectory))
        {
            <DetailsColumn Items="SelectedItems.Where(item => !item.IsDirectory).ToList()">
                <EditAction>
                    @if (EditorService != null)
                    {
                        <button type="button" class="file-edit-link" title="@EditButtonTitle"
                                @onclick="EditSelectedFileAsync" disabled="@(!CanEditSelectedFile)">
                            <FluentIcon Value="@IconEditFile" />
                            <span>Edit file</span>
                        </button>
                    }
                </EditAction>
            </DetailsColumn>
        }
    </div>

    @if (SelectionMode == SelectionMode.SaveFile)
    {
        <div class="save-file-input">
            <RelayTextInput @bind-Value="SaveFileName"
                             Placeholder="Enter file name"
                             Style="width: 100%;"
                             Immediate="true" />
            @if (!string.IsNullOrEmpty(SaveFileNameError))
            {
                <div class="error-message">@SaveFileNameError</div>
            }
        </div>
    }

    <!-- Bottom Toolbar -->
    <div class="bottom-toolbar">
        @if (ShowSelectionButtons)
        {
            @if (ShowCancelButton)
            {
                <FluentButton OnClick="CancelSelection">Cancel</FluentButton>
            }
            <FluentButton Style="margin-left: 8px;"
                          Appearance="ButtonAppearance.Primary"
                          OnClick="ConfirmSelection"
                          Disabled="@IsSelectButtonDisabled">
                @(SelectionMode == SelectionMode.SaveFile ? "Save" : "Select")
            </FluentButton>
        }
    </div>

    <!-- Rename Popover -->
    <RelayPopover Style="width: 250px;" AnchorId="@ControlId("buttonRename")" @bind-Opened="IsRenameModalVisible">
            @if (IsRenameModalVisible)
            {


        <RelayTextInput Style="width: 100%;" @bind-Value="NewName" Placeholder="Enter new name" />
        <div style="display: flex;">
            <FluentButton OnClick="ConfirmRenameAsync" Appearance="ButtonAppearance.Primary">Rename</FluentButton>
            <FluentButton Style="margin-left: 10px;" OnClick="() => IsRenameModalVisible = false">Cancel</FluentButton>
        </div>


            }
        </RelayPopover>

    <!-- Create Folder Popover -->
    <RelayPopover Style="width: 250px;" AnchorId="@ControlId("buttonCreateFolder")" @bind-Opened="IsCreateFolderModalVisible">
            @if (IsCreateFolderModalVisible)
            {


        <RelayTextInput Style="width: 100%;" @bind-Value="NewFolderName" Placeholder="Enter folder name" />
        <div style="display: flex;">
            <FluentButton OnClick="ConfirmCreateFolderAsync" Appearance="ButtonAppearance.Primary">Create</FluentButton>
            <FluentButton Style="margin-left: 10px;" OnClick="() => IsCreateFolderModalVisible = false">Cancel</FluentButton>
        </div>


            }
        </RelayPopover>

    <!-- Delete Confirmation Popover -->
    <RelayPopover Style="width: 250px;" AnchorId="@ControlId("buttonDelete")" @bind-Opened="IsDeleteConfirmationVisible">
            @if (IsDeleteConfirmationVisible)
            {


        <h4 style="margin-bottom: 0.25rem">Are you sure?</h4>
        <div class="delete-item-list">
            @if (SelectedItems.Any())
            {
                @foreach (var item in SelectedItems)
                {
                    @item.Name

                    <br />
                }
            }
            else if (FolderLevels.Count > 1)
            {
                @FolderLevels.Last().Path
            }
        </div>
        <div style="display: flex;">
            <FluentButton OnClick="ConfirmDeleteAsync" Appearance="ButtonAppearance.Primary">Delete</FluentButton>
            <FluentButton Style="margin-left: 10px;" OnClick="() => IsDeleteConfirmationVisible = false">Cancel</FluentButton>
        </div>


            }
        </RelayPopover>
</div>
