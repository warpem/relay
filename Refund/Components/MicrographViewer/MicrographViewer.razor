@using Microsoft.FluentUI.AspNetCore.Components

<div id="@elementId" @ref="containerElement" class="micrograph-viewer-container"
     style="position: relative; width: 100%; height: 100%; min-width: @(MinWidth)px; min-height: @(MinHeight)px; overflow: hidden;">
    <div data-micrograph-surface style="position: relative; width: 100%; height: 100%;"></div>
    <div class="micrograph-controls">
        <ViewerToolbar Style="position: absolute; top: 10px; left: 10px;">

            <div style="display: flex; flex-direction: column;">
                <span class="menu-header">Zoom</span>
                <ZoomControls ZoomLevel="@zoomLevel" IsToggledScale="@showScaleBar" OnIsToggledScaleChanged="OnScaleBarToggled"
                              OnZoomChanged="OnZoomChanged" OnFitToViewport="OnFitToViewport"/>
            </div>

            @if (!string.IsNullOrWhiteSpace(ParticleStarPath))
            {
                <div class="menu-separator"></div>

                <div style="display: flex; flex-direction: column;">
                    <span class="menu-header">Particles</span>
                    <ParticleControls IsToggledPicking="isPickingParticles" ParticleDiameter="@particleDiameter"
                                      ParticleBoxSize="@particleBoxSize" ParticleColor="@particleColor"
                                      ParticleShape="@particleShape" CanPickParticles="@CanEditParticles"
                                      CanControlParticleDisplay="@CanControlParticleDisplay"
                                      OnParticleSettingsChanged="@(a => OnParticleSettingsChanged(a))"/>
                </div>
            }

            @if (CanEditMask || !string.IsNullOrWhiteSpace(MaskPath))
            {
                <div class="menu-separator"></div>

                <div style="display: flex; flex-direction: column;">
                    <span class="menu-header">Mask</span>
                    <MaskControls IsToggledShow="showMask" IsToggledPaint="@isPaintingMask" BrushDiameter="@maskBrushDiameter"
                                  CanEditMask="@CanEditMask"
                                  OnMaskSettingsChanged="@(a => OnMaskSettingsChanged(a))"/>
                </div>
            }
        </ViewerToolbar>

    </div>
</div>
