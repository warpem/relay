@using Refund.Utils

@if (_item != null && _item.Value.Metadata is WarpTools.MiniJsonFsItem miniFs)
{
    var item = _item.Value;
    
    <div style="display: flex; flex-wrap: nowrap; gap: 0.5rem;">
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.0rem; font-size: 0.75rem;">
            <span>@(Path.GetFileName(miniFs.Path))</span>
            
            @if (miniFs.Defocus != null)
            {
                <span>Defocus: @(miniFs.Defocus.Value.ToString("F3")) µm</span>
            }
            
            @if (miniFs.Resolution != null)
            {
                <span>CTF fit resolution: @(miniFs.Resolution.Value.ToString("F1")) Å</span>
            }
            
            @if (miniFs.Phase != null)
            {
                <span>Phase shift: @(miniFs.Phase.Value.ToString("F2")) 𝛑</span>
            }
            
            @if (miniFs.Motion != null)
            {
                <span>Average frame motion: @(miniFs.Motion.Value.ToString("F1")) Å</span>
            }
            
            @if (miniFs.ParticleCount != null || miniFs.Junk != null)
            {
                <div style="display: flex;">
                    @if (miniFs.ParticleCount != null)
                    {
                        <span>@(miniFs.ParticleCount.Value.ToString()) particles</span>
                    }
                    @if (miniFs.ParticleCount != null && miniFs.Junk != null)
                    {
                        <span>,&nbsp;</span>
                    }
                    @if (miniFs.Junk != null)
                    {
                        <span>@(miniFs.Junk.Value.ToString("F0")) % 💩</span>
                    }
                </div>
            }
        </div>
        
        @if (GetThumbnail != null)
        {
            <div style="height: @(ThumbnailSize)px;">
                <img src="@FileService.GetUrl(GetThumbnail(miniFs.Path))" alt="@Path.GetFileName(miniFs.Path)"
                     style="max-width: 100%; max-height: 100%;"/>
            </div>
        }
    </div>
}