@{
    // The service swaps CurrentJob from thread-pool callbacks; read it once per render.
    var job = Service?.CurrentJob;
}
<div class="expanded-job-view">
    @if (job?.IsIterative == true)
    {
        <div style="padding-left: 40px;">
            <RelayErrorBoundary Region="Iteration selector" Compact="true" ResetKey="@job">
                <IterationPagination/>
            </RelayErrorBoundary>
        </div>
    }

    <div class="content-container">
        @if (job != null)
        {
            var key = job.Space.Project.Id + "-" + job.Space.Id + "-" + job.Id;
            <RelayErrorBoundary Region="Log panel" Compact="true" ResetKey="@key">
                <LogPanel/>
            </RelayErrorBoundary>

            <div class="visualization-container">
                @if (job.ExpandedViewType != null)
                {
                    @* Keyed by job, iteration and status: a failure stays with the job that caused it, and
                       picking another iteration or new results landing gives the view another try. *@
                    <RelayErrorBoundary @key="@key" Region="This job's view" ResetKey="@((Service.CurrentIteration, job.Status))">
                        <DynamicComponent Type="@job.ExpandedViewType"/>
                    </RelayErrorBoundary>
                }
            </div>
        }
    </div>
</div>
