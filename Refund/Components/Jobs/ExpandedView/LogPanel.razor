@using Refund.Services
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div class="log-panel @(Service.IsLogPanelExpanded ? "expanded" : "")">

    <div class="log-panel-handle">
        <div class="handle-buttons">
            
            <div class="button-wrapper">
                <FluentCounterBadge ShowEmpty="false" Dot="@(Service.HasNewLogs && !_showingLogs)" Color="BadgeColor.Brand"><AnchorContent>
                    <FluentButton Id="@_outputButtonId"
                                  Style="@($"anchor-name: --{_outputButtonId};")"
                                  IconStart="@(new Icons.Regular.Size24.DocumentText())"
                                  Appearance="@(_showingLogs ?
                                                    ButtonAppearance.Primary :
                                                    null)"
                                  BackgroundColor="@(_showingLogs ?
                                                         null :
                                                         "transparent")"
                                  OnClick="@(_ => TogglePanel(LogSection.Output))" />
                </AnchorContent></FluentCounterBadge>
                <FluentTooltip Anchor="@_outputButtonId"
                               Positioning="Positioning.After">
                    Show output log
                </FluentTooltip>
            </div>
            
            @if (!string.IsNullOrEmpty(Service?.CurrentStaging))
            {
                <div class="button-wrapper">
                    <FluentCounterBadge ShowEmpty="false" Dot="@(Service.HasNewStaging && !_showingStaging)" Color="BadgeColor.Brand"><AnchorContent>
                        <FluentButton Id="@_stagingButtonId"
                                      Style="@($"anchor-name: --{_stagingButtonId};")"
                                      IconStart="@(new Icons.Regular.Size24.HeartPulse())"
                                      Appearance="@(_showingStaging ?
                                                        ButtonAppearance.Primary :
                                                        null)"
                                      BackgroundColor="@(_showingStaging ?
                                                             null :
                                                             "transparent")"
                                      OnClick="@(_ => TogglePanel(LogSection.Staging))"/>
                    </AnchorContent></FluentCounterBadge>
                    <FluentTooltip Anchor="@_stagingButtonId"
                                   Positioning="Positioning.After">
                        Show lifecycle log
                    </FluentTooltip>
                </div>
            }

            @if (!string.IsNullOrEmpty(Service?.CurrentErrors))
            {
                <div class="button-wrapper">
                    <FluentCounterBadge ShowEmpty="false" Dot="@(Service.HasNewErrors && !_showingErrors)" Color="BadgeColor.Danger"><AnchorContent>
                        <FluentButton Id="@_errorButtonId"
                                      Style="@($"anchor-name: --{_errorButtonId};")"
                                      IconStart="@(new Icons.Regular.Size24.Warning().WithColor(_showingErrors ? 
                                                                                                    "white" : 
                                                                                                    "var(--error)"))"
                                      BackgroundColor="@(_showingErrors ?
                                                             "var(--error)" :
                                                             "transparent")"
                                      OnClick="@(_ => TogglePanel(LogSection.Errors))"/>
                        </AnchorContent></FluentCounterBadge>
                    <FluentTooltip Anchor="@_errorButtonId" Positioning="Positioning.After">
                        Show error log
                    </FluentTooltip>
                </div>
            }
        </div>
    </div>

    <div class="log-panel-content">
        <div class="panel-header">
            <div class="section-title">
                @(Service.CurrentSection switch
                {
                    LogSection.Staging => "Lifecycle Log",
                    LogSection.Output => "Output Log",
                    LogSection.Errors => "Error Log",
                    _ => ""
                })
            </div>
        </div>
        <div class="log-content" @ref="_logContentElement">
            @if (Service.CurrentSection == LogSection.Staging)
            {
                <pre>@Service.CurrentStaging</pre>
            }
            else if (Service.CurrentSection == LogSection.Output)
            {
                @* Get a snapshot of iterations to avoid modification during enumeration *@
                var iterations = Service.AvailableIterations;
                @foreach (var iteration in iterations)
                {
                    <div class="log-iteration">
                        @if(iteration > 0)
                        {
                            <div class="iteration-header">Iteration @iteration</div>
                        }
                        <pre>@Service.GetLogsForIteration(iteration)</pre>
                    </div>
                }
            }
            else if (Service.CurrentSection == LogSection.Errors)
            {
                <pre>@Service.CurrentErrors</pre>
            }
        </div>
    </div>
</div>