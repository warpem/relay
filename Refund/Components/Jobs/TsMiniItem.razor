@using Refund.Utils
@using Microsoft.JSInterop

@if (_item != null && _item.Value.Metadata is WarpTools.MiniJsonTsItem miniTs)
{
    var item = _item.Value;
    
    <div style="display: flex; flex-wrap: nowrap; gap: 0.5rem;">
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.0rem; font-size: 0.75rem;">
            <span>@(Path.GetFileName(miniTs.Path))</span>
            
            @if (miniTs.MeanDefocus != null)
            {
                <span>Defocus: @(miniTs.MeanDefocus.Value.ToString("F3")) µm</span>
            }
            
            @if (miniTs.CtfResolution != null)
            {
                <span>CTF fit resolution: @(miniTs.CtfResolution.Value.ToString("F1")) Å</span>
            }
            
            @if (miniTs.TiltMoviePaths != null)
            {
                <span>@(miniTs.TiltMoviePaths.Length.ToString()) tilts</span>
            }
        </div>
        
        @if (GetThumbnail != null && miniTs.TiltMoviePaths != null)
        {
            <div style="height: @(ThumbnailSize)px; position: relative;">
                @* Static background image (middle tilt) *@
                <img src="@FileService.GetUrl(GetThumbnail(miniTs.TiltMoviePaths[miniTs.TiltMoviePaths.Length / 2]))" 
                     alt="@Path.GetFileName(miniTs.Path)"
                     style="max-width: 100%; max-height: 100%;"/>
                
                @* Animation layer that will be controlled by JS *@
                <img class="ts-animation" @ref="AnimationElement" 
                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; z-index: 2;"
                     alt="@Path.GetFileName(miniTs.Path)" />
            </div>
        }
    </div>
}