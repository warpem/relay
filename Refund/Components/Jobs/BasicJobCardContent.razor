@using Refund.DataModel
@using Refund.Utils

@if (Job.Status == JobStatus.Failed)
{
    <div style="display: flex; justify-content: stretch;
                align-items: stretch; width: 100%; height: 100%; padding: 0 10px;">
        <pre style="padding: 0.3rem 0.5rem; min-width: 100%; min-height: 100%;" class="error-message">
            @if (File.Exists(Job.ErrorFilePath))
            {
                @File.ReadAllText(Job.ErrorFilePath)
            }
            else
            {
                <span>No error information available</span>
            }
        </pre>
    </div>
}
else if (Job.VisAvailableIteration >= 0)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
        <ServerImage ServerPath="@Job.VisCard(Job.IsIterative ? Job.VisAvailableIteration : 0)"
                     style="@($"height: {VisualProvider.JabCardContentSquareSideLength * Job.CardSquareCount.Y}px")"/>
    </div>
}
else if (_showQueueInfo)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
        <span style="opacity: 0.6;">Queued in @_queueAlias</span>
    </div>
}
else if (_showLogTail)
{
    <div style="display: flex; justify-content: stretch;
                align-items: stretch; width: 100%; height: 100%; padding: 0 10px;">
        <pre id="@_elementId"
             style="padding: 0.3rem 0.5rem; min-width: 100%; min-height: 100%;
                    overflow-y: hidden;
                    font-size: 0.65rem; line-height: 1.3;
                    opacity: 0.7;">
        </pre>
    </div>
}
