@* 
This component is for
- displaying map orthoslices
- (optionally) displaying mask isolines over the orthoslices

Map and mask orthoslice images generated by bakery contain three square images in one long row, 
example below... 
                            +-----+-----+-----+                                  
                            |     |     |     |                                  
                            |     |     |     |                                  
                            +-----+-----+-----+ 
                            
This allows us to encode and transmit one file and render multiple images on the client side.
*@

<!-- Color filters for coloring mask slices and isolines -->
<svg style="display: none;">
    <filter id="@($"mask-orthoslice-color-{Id}")" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="@(OverlayRGB.R) 0 0    0 0
                                             0 @(OverlayRGB.G) 0    0 0
                                             0 0 @(OverlayRGB.B)    0 0
                                             0 0               0 0.25 0"/>
    </filter>
</svg>
<svg style="display: none;">
    <filter id="@($"mask-isoline-color-{Id}")" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="@(OverlayRGB.R) 0 0 0 0
                                             0 @(OverlayRGB.G) 0 0 0
                                             0 0 @(OverlayRGB.B) 0 0
                                             0 0 0               1 0"/>
    </filter>
</svg>

<!-- Three map slices, each with isoline overlays and border overlay-->
<div class="orthoslice-container" style="@(IsVerticalLayout ? "flex-direction: column;" : "flex-direction: row")">
    @for(int i = 0; i < 3; i++)
    {
        <div class="orthoslice" style="margin: @(SpacingPx/2)px; width: @(RenderedImageSidelengthPx)px; height: @(RenderedImageSidelengthPx)px">
            <div class="map-tile"
                 style="background-position: -@(i * RenderedImageSidelengthPx)px 0px; 
                        background-image: url(@MapOrthoslicesUrl); 
                        background-size: @(3 * RenderedImageSidelengthPx)px @(RenderedImageSidelengthPx)px"/>
            
            @if(MaskOrthoslicesAreVisible && MaskOrthoslicesPath != null)
            {
                <div class="mask-tile"
                     style="background-position: -@(i * RenderedImageSidelengthPx)px 0px; 
                            background-image: url(@MaskOrthoslicesUrl); 
                            background-size: @(3 * RenderedImageSidelengthPx)px @(RenderedImageSidelengthPx)px; 
                            filter: url(#mask-orthoslice-color-@Id)"/>
            }
            
            @if(MaskIsolinesAreVisible && MaskIsolinesPath != null)
            {
                <div class="isoline-tile"
                     style="background-position: -@(i * RenderedImageSidelengthPx)px 0px; 
                            background-image: url(@MaskIsolinesUrl); 
                            background-size: @(3 * RenderedImageSidelengthPx)px @(RenderedImageSidelengthPx)px; 
                            filter: url(#mask-isoline-color-@Id)"/>
            }
            
            <div class="border-overlay" style="border-width: @(BorderWidthPx)px; border-color: @BorderColor"/>
        </div>
    }
</div>