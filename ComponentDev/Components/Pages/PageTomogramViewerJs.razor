@using Refund.Components.TomogramViewerJs
@using Refund.Components.TomogramViewer
@using Warp
@using Warp.Headers
@using Warp.Tools

@page "/TomogramViewerJs"

<PageTitle>Tomogram Viewer JS Test</PageTitle>

<div class="container">
    <div class="controls">
        <FluentCard>
            <h2>Tomogram Viewer JS (Client-Side)</h2>
            <p>Particles: @_particles.Count | Model volume: @(ModelVolumePath != null ? "yes" : "no")</p>
        </FluentCard>
    </div>

    <div class="viewer-container">
        <TomogramViewerJs TomogramPath="@TomogramPath"
                          Species="@_viewerSpecies"
                          MinWidth="800"
                          MinHeight="600" />
    </div>
</div>

<style>
    .container {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100vh;
        padding: 1rem;
        box-sizing: border-box;
    }

    .controls {
        margin-bottom: 1rem;
    }

    .viewer-container {
        flex: 1;
        border: 1px solid #ccc;
        border-radius: 4px;
        overflow: hidden;
        background-color: #f5f5f5;
    }
</style>

@code {
    private string TomogramPath = "";
    private string ModelVolumePath = "";
    private string StarFilePath = "";

    private List<Particle> _particles = new();

    private List<ParticleSpecies> _viewerSpecies;

    private void RebuildViewerSpecies()
    {
        _viewerSpecies = _particles == null || _particles.Count == 0 ? null : new()
        {
            new ParticleSpecies
            {
                Name = "Particles",
                Particles = _particles,
                ModelVolumePath = ModelVolumePath
            }
        };
    }

    protected override void OnInitialized()
    {
        try
        {
            var starFile = new Star(StarFilePath);

            bool hasCoords = starFile.HasColumn("rlnCoordinateX") &&
                             starFile.HasColumn("rlnCoordinateY") &&
                             starFile.HasColumn("rlnCoordinateZ");

            bool hasAngles = starFile.HasColumn("rlnAngleRot") &&
                             starFile.HasColumn("rlnAngleTilt") &&
                             starFile.HasColumn("rlnAnglePsi");

            if (!hasCoords) return;

            float3[] coordinates = starFile.GetRelionCoordinates();
            float3[] angles = hasAngles ? starFile.GetRelionAngles() : null;

            // Check if coordinates are normalized (0-1 range)
            bool areNormalized = coordinates.Any() &&
                                 coordinates.Select(v => Math.Max(v.X, Math.Max(v.Y, v.Z))).Max() < 1.1f;

            // Get tomogram dimensions for scaling
            var tomoDims = MapHeader.ReadFromFile(TomogramPath).Dimensions;
            var fVolDims = new float3(tomoDims);

            for (int i = 0; i < coordinates.Length; i++)
            {
                var position = coordinates[i];
                if (areNormalized)
                    position *= fVolDims;

                var angle = hasAngles && i < angles.Length ? angles[i] : new float3(0, 0, 0);
                _particles.Add(new Particle(position, angle, 0f));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading particles: {ex.Message}");
        }

        RebuildViewerSpecies();
    }
}
