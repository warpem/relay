@page "/histogram"
@using Refund.Components.Histogram
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>Histogram Demo</PageTitle>

<div class="container">
    <h1>Histogram Component Demo</h1>
    
    <div class="controls">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentSwitch @bind-Value="rangeSelectionEnabled" Label="Range Selection" />
            <FluentSwitch @bind-Value="disabled" Label="Disabled" />
            
            <FluentNumberField TValue="@(int)" Value="@bins" Min="5" Max="50" ValueChanged="@OnBinsChanged" Label="Number of Bins" />
            
            <FluentNumberField TValue="@(decimal)" @bind-Value="minRange" Min="-100" Max="100" Label="Min Range" />
            <FluentNumberField TValue="@(decimal)" @bind-Value="maxRange" Min="-100" Max="100" Label="Max Range" />
            
            <FluentNumberField TValue="@(decimal)" @bind-Value="stepSize" Min="0" Max="10" Label="Step Size" />
            <FluentNumberField TValue="@(int)" @bind-Value="minGap" Min="0" Max="10" Label="Min Gap (steps)" />
        </FluentStack>
    </div>
    
    <div class="histogram-demo">
        <Histogram 
            BinSizes="@binSizes"
            MinRange="@minRange"
            MaxRange="@maxRange"
            Color="#ddd"
            RangeSelectionEnabled="@rangeSelectionEnabled"
            SelectedRangeStart="@rangeStart"
            SelectedRangeEnd="@rangeEnd"
            SelectedRangeChanged="OnRangeChanged"
            StepSize="@stepSize"
            MinGap="@minGap"
            IsDisabled="@disabled" />
    </div>
    
    @if (rangeSelectionEnabled)
    {
        <div class="range-info">
            <p>Selected Range: @rangeStart to @rangeEnd</p>
        </div>
    }
</div>

<style>
    .container {
        padding: 20px;
        max-width: 800px;
        margin: 0 auto;
    }
    
    .controls {
        margin-bottom: 20px;
        background-color: #f5f5f5;
        padding: 16px;
        border-radius: 4px;
    }
    
    .histogram-demo {
        height: 300px;
        margin-bottom: 20px;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 16px;
    }
    
    .range-info {
        text-align: center;
        margin-top: 20px;
        font-weight: bold;
    }
</style>

@code {
    private decimal[] binSizes = [];
    private bool rangeSelectionEnabled = true;
    private bool disabled = false;
    private decimal minRange = 0;
    private decimal maxRange = 100;
    private decimal rangeStart = 25;
    private decimal rangeEnd = 75;
    private decimal stepSize = 5;
    private int minGap = 1;
    private int bins = 20;
    private readonly Random random = new Random();

    protected override void OnInitialized()
    {
        GenerateRandomData();
    }

    private void GenerateRandomData()
    {
        // Generate some random bin sizes
        binSizes = new decimal[bins];
        for (int i = 0; i < bins; i++)
        {
            // Simulate a normal-ish distribution
            double x = (double)i / bins;
            double gaussian = Math.Exp(-Math.Pow((x - 0.5) / 0.15, 2));
            double noise = random.NextDouble() * 0.3;
            binSizes[i] = (decimal)(gaussian + noise);
        }
    }

    private void OnBinsChanged(int value)
    {
        bins = value;
        GenerateRandomData();
    }

    private void OnRangeChanged((decimal Start, decimal End) range)
    {
        rangeStart = range.Start;
        rangeEnd = range.End;
    }
}