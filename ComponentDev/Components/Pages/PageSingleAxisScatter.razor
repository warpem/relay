@code {

    ObservableCollection<ScatterPoint> _points1 = new();
    ObservableCollection<ScatterPoint> _points2 = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        RandomNormal randN = new(123);
        Random rand = new(123);

        Color[] colors =
        [
            Color.FromArgb(100, 120, 180, 0),
            Color.FromArgb(100, 120, 180, 0),
            Color.FromArgb(100, 120, 180, 0),
            Color.FromArgb(100, 120, 180, 0),
            Color.FromArgb(100, 120, 180, 0),
            Color.FromArgb(100, 180, 0, 0)
        ];

        for (int i = 0; i < 1000; i++)
        {
            _points1.Add(new ScatterPoint(randN.NextSingle(0, 10), colors[rand.Next(colors.Length)], null));
            _points2.Add(new ScatterPoint(randN.NextSingle(0, 10), colors[rand.Next(colors.Length)], null));
        }
    }
}