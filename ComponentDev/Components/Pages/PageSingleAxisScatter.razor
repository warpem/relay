@page "/scatterplot"
@using System.Collections.ObjectModel
@using Refund.Components.SingleAxisScatter
@using Warp.Tools
@using Color = System.Drawing.Color
@using Refund.Components.GlobalTooltip

<div style="display: flex; flex-direction: column; gap: 4rem;">
    <SingleAxisScatter Points="@_points1.ToList()" Style="width: 100%; height: 100px;">
        <TooltipTemplate>
            <div style="width: 100px; height: 100px; background-color: white; display: flex; align-items: center; justify-content: center;">
                @if (context != null)
                {
                    @context.Value.Value.Value.ToString("F3")
                }
            </div>
        </TooltipTemplate>
    </SingleAxisScatter>
    
