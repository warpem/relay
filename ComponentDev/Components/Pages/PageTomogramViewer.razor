@using Refund.Components
@using Refund.Components.TomogramViewer

@page "/TomogramViewer"

<PageTitle>Tomogram Viewer Test</PageTitle>

<div class="container">
    <div class="controls">
        <FluentCard>
            <h2>Tomogram Viewer Test</h2>
            <p>This is a test page for the TomogramViewer component with particle preview functionality.</p>
            <p>When in particle picking mode, a dashed circle preview will appear on all three planes.</p>
        </FluentCard>
    </div>
    
    <div class="viewer-container">
        <TomogramViewer 
            TomogramPath="@TomogramPath"
            MinWidth="800"
            MinHeight="600"
            CanShowParticlesControls="true" />
    </div>
</div>

<style>
    .container {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100vh;
        padding: 1rem;
        box-sizing: border-box;
    }
    
    .controls {
        margin-bottom: 1rem;
    }
    
    .viewer-container {
        flex: 1;
        border: 1px solid #ccc;
        border-radius: 4px;
        overflow: hidden;
        background-color: #f5f5f5;
    }
</style>

@code {
    private string TomogramPath = "";
    private string ParticleStarPath = "";
}