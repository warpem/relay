@using ComponentDev.Services
@using Refund.Components.MicrographViewer
@using Refund.Components.FourierSpace

<div class="evidence monitor">
    <div class="exposure-heading"><span><b>#@((Movie.Index + 1).ToString("N0"))</b><span class="file-name" title="@Movie.Name">@Movie.Name</span></span><span class="exposure-state"><i style="background:@Session.StatusColor(Movie)"></i>@Session.Status(Movie)</span></div>
    <div class="evidence-controls">
        <div class="exposure-navigation"><FluentButton Title="Previous exposure" OnClick="@(() => Select(Movie.Index - 1))" Disabled="@(Movie.Index == 0)" Appearance="ButtonAppearance.Subtle">‹</FluentButton><FluentButton Title="Next exposure" OnClick="@(() => Select(Movie.Index + 1))" Disabled="@(Movie.Index == Session.Movies.Count - 1)" Appearance="ButtonAppearance.Subtle">›</FluentButton></div>
        <div class="view-modes"><FluentButton Class="@(!ShowEnhanced ? "active-view" : "")" Appearance="ButtonAppearance.Subtle" OnClick="@(() => _enhanced = false)">Average</FluentButton><FluentButton Class="@(ShowEnhanced ? "active-view" : "")" Appearance="ButtonAppearance.Subtle" Disabled="@(!Movie.Done.HasFlag(PreviewStage.Enhance))" OnClick="@(() => _enhanced = true)">Enhanced</FluentButton></div>
        <span class="spacer"></span>
        <div class="disposition-controls" aria-label="Movie selection"><FluentButton Appearance="@DispositionAppearance(PreviewDisposition.Auto)" OnClick="@(() => SetDisposition(PreviewDisposition.Auto))">Filter rules</FluentButton><FluentButton Appearance="@DispositionAppearance(PreviewDisposition.Keep)" OnClick="@(() => SetDisposition(PreviewDisposition.Keep))">Keep</FluentButton><FluentButton Appearance="@DispositionAppearance(PreviewDisposition.Exclude)" OnClick="@(() => SetDisposition(PreviewDisposition.Exclude))">Exclude</FluentButton></div>
    </div>
    <div class="diagnostic-grid">
        <section class="micrograph-evidence">
            <div class="figure-meta"><div class="figure-heading"><b>@(ShowEnhanced ? "Denoised · deconvolved" : "Dose-weighted average")</b><span>Motion @Value(Movie.Motion, PreviewStage.Motion) Å/frame</span></div></div>
            <div class="micrograph-square">@if (Movie.Done.HasFlag(PreviewStage.Motion)) { <MicrographViewer MicrographPath="@Session.Fixtures.StudyImage(Movie.Index, Condition(Movie), ShowEnhanced)" ThumbnailPath="@Session.Fixtures.StudyThumbnail(Movie.Index, Condition(Movie))" MinWidth="200" MinHeight="200" CanEditParticles="false" CanEditMask="false" /> } else { <div class="empty-evidence">Awaiting motion correction</div> }</div>
        </section>
        <section class="fourier-evidence">
            <div class="figure-meta"><div class="figure-heading"><b>CTF fit</b><span>@Value(Movie.Ctf, PreviewStage.Ctf) Å</span></div>
            <div class="spectral-readings"><span>Defocus <b>@Value(Movie.Defocus, PreviewStage.Ctf) µm</b></span><span>Ice <b>@Value(Movie.Ice, PreviewStage.Ctf, "F0") Å</b></span></div>
            <div class="spectrum-key"><span>― Measured</span><span>― Fitted</span><span>― Quality</span></div>
            <div class="fixture-caption">Illustrative CTF fixture</div></div>
            @if (Movie.Done.HasFlag(PreviewStage.Ctf)) { <div class="real-spectrum"><AmplitudeSpectrumViewer MovieFilePath="@Session.Fixtures.Movie(Movie.Index)" FittingRangeMin="Session.Settings.CtfMin" FittingRangeMax="Session.Settings.CtfMax" /></div> } else { <div class="empty-evidence">Awaiting CTF estimation</div> }
        </section>
    </div>
</div>

@code {
    [Parameter] public WarpSessionPreview Session { get; set; }
    [Parameter] public PreviewMovie Movie { get; set; }
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
    private bool _enhanced;
    private bool ShowEnhanced => _enhanced && Movie.Done.HasFlag(PreviewStage.Enhance);
    public static string Condition(PreviewMovie movie) => movie.Ice > 900 && movie.Ctf > 5 ? "lowcontrast" : movie.Motion > 2.5 ? "drift" : "normal";
    private string Value(double value, PreviewStage stage, string format = "F2") => Movie.Done.HasFlag(stage) ? value.ToString(format) : "—";
    private ButtonAppearance DispositionAppearance(PreviewDisposition disposition) => Movie.Disposition == disposition ? ButtonAppearance.Primary : ButtonAppearance.Subtle;
    private void SetDisposition(PreviewDisposition disposition) => Session.SetDisposition([Movie.Index], disposition);
    private Task Select(int index) => SelectedIndexChanged.InvokeAsync(Math.Clamp(index, 0, Session.Movies.Count - 1));
}
