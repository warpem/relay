@using Refund.Services.Core.Session
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject RelaySession Session

<div style="position: relative; width: 100%; height: 100%; padding: 8px 8px 0px 8px;">
    <div style="position: absolute; top: 0px; right: 0px; z-index: 999;">
        <FluentButton IconEnd="@(new Icons.Regular.Size24.DismissSquare())"
                      BackgroundColor="transparent"
                      OnClick="OnCloseButtonClick">
        </FluentButton>
    </div>
    
    @ChildContent
</div>