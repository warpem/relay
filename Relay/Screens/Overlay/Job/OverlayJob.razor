@using Refund.Components.Jobs.ExpandedView
@using Refund.DataModel
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div style="position: relative; 
            width: 100%; height: 100%; 
            display: flex; flex-direction: column;">
    
    <div class="job-overlay-header">
        <h4 title="@Session.Job.QualifiedName">@Session.Job.QualifiedName</h4>
        
        @if (Session.Job.IsInteractive && 
             Session.Job.Status == JobStatus.Running && 
             !Session.Job.IsInteractiveFinished)
        {
            <FluentButton IconStart="@(new Icons.Regular.Size20.FlagCheckered())"
                          Appearance="Appearance.Accent"
                          Loading="@(Session.Job.IsInteractiveFinished)"
                          OnClick="HandleFinishInteractiveClicked">
                Finish interactive job
            </FluentButton>
        }
    </div>
    
    <div style="position: absolute; top: 0px; right: 0px;">
        <FluentButton IconEnd="@(new Icons.Regular.Size24.DismissSquare())"
                      BackgroundColor="transparent"
                      Title="Close job viewer"
                      OnClick="@(_ => Session.NavigateToAsync(new()
                               {
                                   ProjectId = Session.ProjectId,
                                   SpaceId = Session.SpaceId,
                                   ViewId = Session.ViewId,
                                   FolderId = Session.FolderId,
                                   FactoryInstanceId = Session.FactoryInstanceId,
                                   JobId = null,
                                   Overlay = Session.CurrentOverlay
                               }))">
        </FluentButton>
    </div>

    <ExpandedJobView/>
</div>
