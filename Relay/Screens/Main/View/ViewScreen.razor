@using Refund.DataModel
@using Refund.DataModel.ReadOnly
@using Refund.Services
@using Relay.Panels.Right.Actions
@using Relay.Screens.Main.Base
@inherits ListingScreenLogic<IViewItem>

<div class="view-screen-container">
    <ViewToolbar CanMoveLeft="@CanMoveLeft"
                 CanMoveRight="@CanMoveRight"
                 OnMoveLeft="@HandleMoveLeft"
                 OnMoveRight="@HandleMoveRight"
                 IsBrowseMode="@IsBrowseMode" />

    <div class="view-screen-content"
         @ondragover:preventDefault="@(!IsBrowseMode)"
         @ondrop="HandleBackgroundDrop">
        @if (DiagramService.ViewMode == ViewMode.List)
        {
            <ListingScreen TItem="IViewItem"
                           Title="@GetTitle()"
                           CreateButtonText="@GetCreateButtonText()"
                           Items="@GetItems()"
                           ReverseGrid="@SortingService.IsAscending"
                           OnCreateClick="@ShowCreateDialogAsync"
                           OnContextMenu="@OnContextMenu">
                <ItemTemplate>
                    @if (context is ReadOnlyJob job)
                    {
                        <JobCard @key="job.QualifiedName"
                                 Job="job"
                                 OnClick="@(async args => await HandleItemClicked(context, args))"
                                 OnDoubleClick="@(async args => await ItemDoubleClickedAsync(job, args))"
                                 OnMiddleClick="@(async args => await HandleMiddleClick(job, args))"
                                 OnPortClick="@HandlePortClicked"/>
                    }
                    else if (context is ReadOnlyFolder folder)
                    {
                        <FolderCard @key="folder.QualifiedName"
                                    Folder="folder"
                                    OnClick="@(async args => await HandleItemClicked(context, args))"
                                    OnDoubleClick="@(async args => await HandleFolderDoubleClick(folder, args))"/>
                    }
                    else if (context is ReadOnlyFactoryInstance factoryInstance)
                    {
                        <FactoryCard @key="factoryInstance.QualifiedName"
                                     Instance="factoryInstance"
                                     Mode="FactoryCard.FactoryCardMode.Instance"
                                     OnClick="@(async args => await HandleItemClicked(context, args))"
                                     OnDoubleClick="@(async args => await HandleFactoryInstanceDoubleClick(factoryInstance, args))" />
                    }
                </ItemTemplate>
            </ListingScreen>
        }
        else
        {
            <DiagramView Layout="@GetDiagramLayout()"
                         Items="@GetItems()"
                         OnItemClick="@HandleDiagramItemClick"
                         OnItemDoubleClick="@HandleDiagramDoubleClick"
                         OnPortClick="@HandlePortClicked"
                         OnContextMenu="@OnContextMenu"
                         OnBackgroundClick="@(() => Selection.Clear())"
                         OnCardContextMenu="@HandleCardContextMenu" />
        }

        @if (!IsBrowseMode)
        {
            <JobTypeMenu Open="@_jobTypeMenuOpen"
                         OpenChanged="@HandleJobTypeMenuOpenChanged"
                         TypeFilter="@GetJobTypeFilter()"
                         PortFilter="@GetPortFilter()"
                         Type="@GetMenuType()"
                         ClickedPort="@_clickedPort"
                         X="@(_clickedPosition?.X)" Y="@(_clickedPosition?.Y)"
                         OnTypeSelected="@HandleMenuTypeSelected"
                         OnPortSelected="@HandlePortSelected"
                         OnPortConnected="@HandlePortConnected"
                         OnFolderRequested="@HandleFolderCreation"
                         Definitions="@FactoryDefinitions"
                         OnFactorySelected="@HandleFactorySelected"/>
        }

        @if (_cardContextMenuOpen && _cardContextMenuActions != null)
        {
            <RelayMenu Open="@_cardContextMenuOpen" X="@_cardContextMenuX" Y="@_cardContextMenuY"
                         OpenChanged="@(v => { if (!v) CloseCardContextMenu(); })">
                <span class="menu-context-title" title="@_cardContextMenuHeader">
                    @_cardContextMenuHeader
                </span>
                <FluentDivider />
                <ActionMenuLevel Actions="_cardContextMenuActions"/>
            </RelayMenu>
        }
    </div>
</div>
