@using Relay.Emoji
@using Refund.Components.Emoji

<EditForm Model="@Model" OnValidSubmit="OnCreateClick">
    <DataAnnotationsValidator />

    <FluentDialogBody>
        <div class="form-content">
            <div style="width: 100%; display: flex; align-items: center; justify-content: center;">
                <EmojiSelectionButton @bind-Glyph="Model.HeroImage" 
                                      Size="64"
                                      ShowBorder="true"
                                      HorizontalPosition="HorizontalPosition.Center"
                                      VerticalPosition="VerticalPosition.Bottom" />
            </div>

            <div class="form-item">
                <FluentTextField @bind-Value="Model.Name"
                                 Label="Project name"
                                 Required="true"
                                 Immediate="true"
                                 Autofocus="true"
                                 AutoComplete="off"/>
                <FluentValidationMessage For="@(() => Model.Name)"/>
            </div>

            <div class="form-item">
                <FluentTextField @bind-Value="Model.Notes"
                                 Label="Notes"
                                 Immediate="true"
                                 AutoComplete="off"/>
                <FluentValidationMessage For="@(() => Model.Notes)"/>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="error-message">@ErrorMessage</div>
            }
        </div>
    </FluentDialogBody>

    <FluentDialogFooter>
        <FluentButton Type="ButtonType.Button"
                      Appearance="Appearance.Outline"
                      OnClick="OnCancelClick">
            Cancel
        </FluentButton>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="Appearance.Accent">
            Create
        </FluentButton>
    </FluentDialogFooter>
</EditForm>