@using Refund.DataModel.ReadOnly
@using Relay.Panels.Right.Actions
@using Relay.Components.HeroIcon
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@typeparam TItem where TItem : class, IIdentifiable, IAnnotated, IAudited, IJobContainer

<div tabindex="0" data-relay-context="true" id="@CardId"
     class="card-common listing-card@(IsSelected ? " selected" : "")"
     style="width: min(100%, @Width);"
     @onclick:stopPropagation="true"
     @onclick="@OnCardClick"
     @ondblclick:stopPropagation="true"
     @ondblclick:preventDefault="true"
     @ondblclick="@OnHeaderClick">

    <a id="@HeaderId"
       class="listing-card-header"
       href="@NavigationUrl"
       data-relay-navigation="true"
       aria-label="@($"Open {Item.QualifiedName}")"
       @onclick="OnHeaderClick"
       @onclick:stopPropagation="true"
       @ondblclick:stopPropagation="true">

        <HeroIcon Value="@Item.HeroImage" Size="40"/>

        <span class="listing-card-identity">
            <span class="listing-card-name">@Item.QualifiedName</span>
            @if (ExtraDetails != null)
            {
                <span class="listing-card-meta">@ExtraDetails</span>
            }
        </span>

        <span class="listing-card-chevron">
            <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" Color="Color.Neutral"/>
        </span>
    </a>

    @if (!string.IsNullOrWhiteSpace(Item.Notes))
    {
        <FluentTooltip Anchor="@HeaderId"
                       MaxWidth="500px"
                       Position="TooltipPosition.Top">
            <div style="width: 450px;">
                @Item.Notes
            </div>
        </FluentTooltip>
    }

    @if (BodyContent != null)
    {
        <div class="listing-card-body">
            @BodyContent
        </div>
    }

    @if (FooterContent != null)
    {
        <div class="listing-card-footer">
            @FooterContent
        </div>
    }
</div>

<RelayMenu Anchor="@CardId" Trigger="MouseButton.Right"
            OpenChanged="HandleContextMenu">
    <span class="menu-context-title" title="@Item.QualifiedName">
        @Item.QualifiedName
    </span>
    <FluentDivider />

    @if (_contextMenuActions != null)
    {
        <ActionMenuLevel Actions="_contextMenuActions"/>
    }
</RelayMenu>
