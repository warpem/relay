@page "/login"

@using Refund.Configuration.Constants
@using Refund.Configuration

<div class="login-container">
    @* Filled by Login.razor.js with a randomly chosen animated background (wwwroot/login-bg). *@
    <div class="login-bg" aria-hidden="true"></div>

    @if (AuthConfig.AuthenticationType == AuthenticationConfigurationConstants.AuthenticationTypeSSO)
    {
        <div class="sso-card">
            <h2>Relay nice to see you!</h2>
            
            <FluentButton Appearance="ButtonAppearance.Primary"
                          OnClick="@(() => NavigationManager.NavigateTo("/start-sso", forceLoad: true))">
                Sign in via SSO
            </FluentButton>
        </div>
    }
    else
    {
        <div class="login-card">
            <h2>@(_isFirstUser ? "Welcome to Relay!" : _isRegistering ? "Relay nice to meet you!" : "Relay nice to see you!")</h2>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <FluentMessageBar Intent="MessageBarIntent.Error"
                                  Title="@(_isRegistering ? "Registration failed" : "Sign in failed")"
                                  Style="margin-bottom: 1rem;">
                    @_errorMessage
                </FluentMessageBar>
            }

            @if (_isRegistering)
            {
                <EditForm Model="@_registrationModel" OnValidSubmit="HandleRegistration" FormName="registration">
                    <DataAnnotationsValidator/>

                    <div class="form-content">
                        <RelayTextInput @bind-Value="_registrationModel.Username"
                                         Label="Username"
                                         Required="true"
                                         Immediate="true"
                                         Autofocus="true"
                                         AutoComplete="off" />
                        <FluentValidationMessage For="@(() => _registrationModel.Username)"/>

                        <RelayTextInput @bind-Value="_registrationModel.Name"
                                         Label="Name"
                                         Required="true"
                                         Immediate="true"/>
                        <FluentValidationMessage For="@(() => _registrationModel.Name)"/>

                        <RelayTextInput @bind-Value="_registrationModel.Email"
                                         Label="Email"
                                         Required="true"
                                         Type="email"
                                         Immediate="true"
                                         TextInputType="TextInputType.Email"/>
                        <FluentValidationMessage For="@(() => _registrationModel.Email)"/>

                        <RelayTextInput @bind-Value="_registrationModel.Password"
                                         Label="Password"
                                         Required="true"
                                         TextInputType="TextInputType.Password"/>
                        <FluentValidationMessage For="@(() => _registrationModel.Password)"/>

                        @if (!_isFirstUser)
                        {
                            <RelayTextInput @bind-Value="_registrationModel.SecurityToken"
                                             Label="Security Token"
                                             Required="true"
                                             AutoComplete="off" />
                            <FluentValidationMessage For="@(() => _registrationModel.SecurityToken)"/>
                        }

                        <div class="button-row">
                            @if (!_isFirstUser)
                            {
                                <FluentButton Type="ButtonType.Button"
                                              Appearance="ButtonAppearance.Outline"
                                              OnClick="@(() => _isRegistering = false)">
                                    Back to Login
                                </FluentButton>
                            }

                            <FluentButton Type="ButtonType.Submit"
                                          Appearance="ButtonAppearance.Primary"
                                          Loading="@_isLoading">
                                @(_isFirstUser ? "Create Admin Account" : "Create Account")
                            </FluentButton>
                        </div>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="@_loginModel"
                          OnValidSubmit="HandleNativeLogin"
                          @onkeydown="@HandleLoginKeyPress"
                          FormName="login">
                    <DataAnnotationsValidator/>

                    <div class="form-content">
                        <RelayTextInput @bind-Value="_loginModel.Username"
                                         Label="Username"
                                         Required="true"
                                         Immediate="true"
                                         Autofocus="true"
                                         AutoComplete="off"/>
                        <FluentValidationMessage For="@(() => _loginModel.Username)"/>

                        <RelayTextInput @bind-Value="_loginModel.Password"
                                         Label="Password"
                                         Required="true"
                                         Immediate="true"
                                         AutoComplete="off"
                                         Type="password"/>
                        <FluentValidationMessage For="@(() => _loginModel.Password)"/>

                        <FluentCheckbox @bind-Value="_loginModel.RememberMe"
                                        Label="Remember me"/>

                        <div class="button-row">
                            <FluentButton Type="ButtonType.Submit"
                                          Appearance="ButtonAppearance.Primary"
                                          Loading="@_isLoading">
                                Sign in
                            </FluentButton>
                        </div>
                    </div>
                </EditForm>
            }

            @if (!_isRegistering && !_isFirstUser)
            {
                <div class="mode-switch">
                    <FluentButton OnClick="@(() => _isRegistering = true)"
                                  Appearance="ButtonAppearance.Subtle">
                        Need an account? Register here
                    </FluentButton>
                </div>
            }
        </div>
    }
</div>