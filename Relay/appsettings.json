{
  "Authentication": {
    "AuthenticationType": "native"
  },
  "AuthService": {
    "Authority": "",
    "ClientId": "",
    "ResponseType": "code",
    "Scopes": [ "openid", "profile" ],
    "AuthorizationPath": "/oauth2/authorize",
    "TokenPath": "/oauth2/token",
    "LogoutPath": "/logout",
    "LogoutRedirectParameter": "logout_uri"
  },
  "Cache": {
    "SlidingExpirationInSeconds": 900,
    "IsEnabled": true
  },
  "Relay": {
    "ProjectsPath": "projects.relay"
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
