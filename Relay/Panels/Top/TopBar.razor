@using Refund.Services.Core.Session
@using Refund.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div class="top-bar">
    
    <div class="breadcrumb-scroll">
        @* The breadcrumbs are the main way out of a broken screen, so they must not die with it. TopBar itself
           never re-renders on navigation, hence ResetOnNavigation. *@
        <RelayErrorBoundary Region="Navigation" Inline="true" ResetOnNavigation="true">
            <ChildContent>
                <Breadcrumbs/>
            </ChildContent>
            <ErrorActions>
                <FluentButton Size="ButtonSize.Small" OnClick="GoHomeAsync">Home</FluentButton>
            </ErrorActions>
        </RelayErrorBoundary>
    </div>

    <div class="top-bar-actions">
        <div class="current-user">
            <FluentIcon Value="@(new Icons.Regular.Size20.Person().WithColor("var(--colorBrandForeground1)"))" />
            <span title="@Session.User.Name">@Session.User.Name</span>
        </div>

        <FluentButton Appearance="ButtonAppearance.Transparent" Id="Theme"
                      IconEnd="@(Session.ColorTheme == ColorTheme.Light ?
                                     new Icons.Regular.Size20.WeatherSunny().WithColor(Color.Warning) :
                                     new Icons.Regular.Size20.WeatherMoon())"
                      Title="@(Session.ColorTheme == ColorTheme.Light ?
                                   "Switch to dark theme" :
                                   "Switch to light theme")"
                      OnClick="OnThemeButtonClick">
        </FluentButton>

        <FluentButton Appearance="ButtonAppearance.Transparent" IconEnd="@(new Icons.Regular.Size20.PanelRight())"
                      Title="@(Session.IsRightPanelExpanded() ? "Collapse right panel" : "Expand right panel")"
                      Style="margin-right: 8px;"
                      OnClick="OnToggleRightPanel">
        </FluentButton>
    </div>
</div>
