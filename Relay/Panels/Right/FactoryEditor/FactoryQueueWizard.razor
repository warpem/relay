@using Refund.DataModel
@using Refund.DataModel.ReadOnly
@using Refund.Services.Core.DataManager
@using Refund.Services.Core.Session
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div style="display: flex; flex-direction: column; width: 100%; padding: 0;">
    <h5>Queue Assignment</h5>

    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin: 0.5rem 0;">
        @foreach (var subJob in Instance.SubJobs.Where(j => j.Status == JobStatus.Building))
        {
            <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0;">
                <span style="flex: 1; font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                      title="@subJob.QualifiedName">
                    @subJob.QualifiedName
                </span>

                @if (IsLocalJob(subJob))
                {
                    <span style="font-size: 0.8rem; opacity: 0.6;">Local</span>
                }
                else
                {
                    var jobId = subJob.Id;
                    var compatibleQueues = GetCompatibleQueues(subJob);

                    @if (compatibleQueues.Any())
                    {
                        <FluentSelect Items="@compatibleQueues"
                                      Value="@(_assignments.GetValueOrDefault(jobId)?.ToString() ?? "")"
                                      ValueChanged="@(value => HandleQueueChanged(jobId, value))"
                                      OptionText="@(q => q.Alias)"
                                      OptionValue="@(q => q.Id.ToString())"
                                      Style="min-width: 120px;" />
                    }
                    else
                    {
                        <span style="font-size: 0.8rem; color: var(--error);">No compatible queue</span>
                    }
                }
            </div>
        }
    </div>

    @if (HasUnassigned)
    {
        <div style="font-size: 0.8rem; color: var(--error); margin: 0.25rem 0;">
            Some sub-jobs have no queue assigned
        </div>
    }

    <div style="display: flex; justify-content: space-evenly;
                column-gap: 1rem; padding: 1rem 0;">
        <FluentButton Style="width: 100%;"
                      OnClick="OnClose">
            Cancel
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      Style="width: 100%;"
                      Disabled="@(!CanConfirm)"
                      IconStart="@(new Icons.Filled.Size20.Play())"
                      OnClick="HandleConfirm">
            Confirm
        </FluentButton>
    </div>
</div>
