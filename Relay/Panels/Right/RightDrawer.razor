@using Refund.DataModel
@using Refund.DataModel.ReadOnly
@using Refund.Services
@using Refund.Services.Core.DataManager
@using Refund.Services.Core.Session
@using Relay.Panels.Right.JobEditor
@using Relay.Panels.Right.FactoryEditor

@{
    var selectedItems = Selection.SelectedItems;
    var selectedKeys = selectedItems.ToHashSet();
}

@if (JobEditor.IsActive)
{
    <JobEditor />
}
else if (FactoryEditor.IsActive)
{
    <FactoryEditor />
}
else
{
    @switch (Session.CurrentMain)
    {
        case MainScreenType.Home:
            @* Jobs selected in Home activity can come from any accessible space *@
            var homeJobs = Selection.ResolveSelectedJobs();
            @if (homeJobs.Any())
            {
                <JobProperties @key="@("JobProperties")"
                               Jobs="homeJobs" />
            }
            else if (selectedItems.Any(k => k.Type == ItemType.Project))
            {
                <ProjectProperties @key="@("ProjectProperties")"
                                   Projects="DataManager.GetUserProjects(Session.User).
                                   Where(p => selectedKeys.Contains(SelectionKey.ForProject(p.Id)))"/>
            }
            else
            {
                <HomeProperties @key="@("HomeProperties")"/>
            }

            break;

        case MainScreenType.Project:
            @if (selectedItems.Any())
            {
                <SpaceProperties @key="@("SpaceProperties")"
                                 Spaces="Session.Project.Spaces.Where(s => selectedKeys.Contains(SelectionKey.ForSpace(s.Id)))"/>
            }
            else
            {
                <ProjectProperties @key="@("ProjectProperties")"
                                   Projects="@([Session.Project])" />
            }

            break;

        case MainScreenType.Space:
            @if (selectedItems.Where(k => k.Type == ItemType.FactoryDefinition).Select(k => k.Id).Any())
            {
                var selectedDefIds = selectedItems.Where(k => k.Type == ItemType.FactoryDefinition).Select(k => k.Id).ToHashSet();
                var selectedDefs = Session.Space?.FactoryDefinitions.Where(d => selectedDefIds.Contains(d.Id)).ToList();
                @if (selectedDefs?.Any() == true)
                {
                    <FactoryDefinitionProperties @key="@("FactoryDefinitionProperties")"
                                                  Definitions="selectedDefs"
                                                  IsLocked="selectedDefs.Count() == 1 && Session.Space?.FactoryInstances.Any(i => i.DefinitionId == selectedDefs.First().Id) == true" />
                }
            }
            else if (selectedItems.Any())
            {
                <ViewProperties @key="@("ViewProperties")"
                                Views="Session.Space.Views.Where(v => selectedKeys.Contains(SelectionKey.ForView(v.Id)))"/>
            }
            else
            {
                <SpaceProperties @key="@("SpaceProperties")"
                                 Spaces="@([Session.Space])" />
            }

            break;

        case MainScreenType.View:
            @if (Session.Job != null)
            {
                <JobProperties @key="@("JobProperties")"
                               Jobs="@([Session.Job])" />
            }
            else if (selectedItems.Any())
            {
                var selectedFolderIds = selectedItems.Where(k => k.Type == ItemType.Folder).Select(k => k.Id).ToList();
                @if (selectedFolderIds.Any())
                {
                    var folder = Session.View?.FindFolder(selectedFolderIds[0]);
                    @if (folder != null)
                    {
                        <FolderProperties @key="@("FolderProperties")"
                                          Folder="folder" />
                    }
                }
                else if (selectedItems.Where(k => k.Type == ItemType.FactoryInstance).Select(k => k.Id).Any())
                {
                    var fiId = selectedItems.Where(k => k.Type == ItemType.FactoryInstance).Select(k => k.Id).First();
                    var fi = Session.View?.FindFactoryInstance(fiId);
                    @if (fi != null)
                    {
                        <FactoryInstanceProperties @key="@("FactoryInstanceProperties")"
                                                   FactoryInstance="fi" />
                    }
                }
                else
                {
                    <JobProperties @key="@("JobProperties")"
                                   Jobs="Session.Space.Jobs.Where(j => selectedKeys.Contains(SelectionKey.ForJob(j.Id))).ToList()"/>
                }
            }
            else if (Session.FactoryInstance != null)
            {
                <FactoryInstanceProperties @key="@("FactoryInstanceProperties")"
                                            FactoryInstance="Session.FactoryInstance" />
            }
            else if (Session.Folder != null)
            {
                <FolderProperties @key="@("FolderProperties")"
                                  Folder="Session.Folder" />
            }
            else
            {
                <ViewProperties @key="@("ViewProperties")"
                                Views="@([Session.View])" />
            }

            break;

        case MainScreenType.FactoryBuilder:
            @* In builder mode, JobEditor shows when a sub-job is selected.
               Otherwise show factory definition properties. *@
            @if (Session.FactoryDefinition != null)
            {
                <FactoryDefinitionProperties @key="@("FactoryDefinitionProperties")"
                                              Definitions="@([Session.FactoryDefinition])"
                                              IsLocked="Session.Space?.FactoryInstances.Any(i => i.DefinitionId == Session.FactoryDefinition.Id) == true" />
            }
            break;
    }
}
