
@foreach (var action in Actions)
{
    @if (action.SubActions.Any())
    {
        <RelayMenuItem Label="@action.Name" LabelStyle="@(action.IsDisabled ? "text-decoration: line-through;" : null)" Style="@GetItemStyle(action)">
            <MenuItems>
                <ActionMenuLevel Actions="action.SubActions" />
            </MenuItems>
            
            <ChildContent>
                @if (action.IconSmall != null)
                {
                    <span slot="start" style="height: 16px;">
                        <FluentIcon Value="@action.IconSmall"/>
                    </span>
                }
            </ChildContent>
        </RelayMenuItem>
    }
    else
    {
        @if (action.IsDisabled)
        {
            <RelayMenuItem Label="@action.Name" LabelStyle="@(action.IsDisabled ? "text-decoration: line-through;" : null)" Style="@GetItemStyle(action)">
                <MenuItems>
                    <div style="padding: 0.4rem 1rem; max-width: 200px; text-wrap: pretty;">
                        @action.DisabledBecause
                    </div>
                </MenuItems>

                <ChildContent>
                    @if (action.IconSmall != null)
                    {
                        <span slot="start" style="height: 16px;">
                            <FluentIcon Value="@action.IconSmall"/>
                        </span>
                    }
                </ChildContent>
            </RelayMenuItem>
        }
        else if (action.NeedsConfirmation)
        {
            <RelayMenuItem Label="@action.Name" LabelStyle="@(action.IsDisabled ? "text-decoration: line-through;" : null)" Style="@GetItemStyle(action)">
                <MenuItems>
                    <RelayMenuItem Label="I'm sure"
                                    Style="color: var(--warning);">
                        <MenuItems>
                            <RelayMenuItem Label="Yes, I'm really sure"
                                            OnClick="@action.Action"
                                            Style="color: var(--error);" />
                        </MenuItems>
                    </RelayMenuItem>
                </MenuItems>

                <ChildContent>
                    @if (action.IconSmall != null)
                    {
                        <span slot="start" style="height: 16px;">
                        <FluentIcon Value="@action.IconSmall"/>
                    </span>
                    }
                </ChildContent>
            </RelayMenuItem>
        }
        else
        {
            <RelayMenuItem Label="@action.Name" LabelStyle="@(action.IsDisabled ? "text-decoration: line-through;" : null)" OnClick="@action.Action"
                            Style="@GetItemStyle(action)">
                @if (action.IconSmall != null)
                {
                    <span slot="start" style="height: 16px;">
                        <FluentIcon Value="@action.IconSmall"/>
                    </span>
                }
            </RelayMenuItem>
        }
    }
}