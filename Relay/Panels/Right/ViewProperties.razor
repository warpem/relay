@using Refund.DataModel.ReadOnly
@using Refund.Services
@using Refund.Services.Core.DataManager
@using Refund.Services.Core.Session
@using Refund.Components.FileBrowser
@using Relay.Panels.Right.Actions
@using Refund.Components.Emoji
@using Refund.DataModel
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject MenuActionService MenuActions

<div style="display: flex; flex-direction: column; justify-content: flex-start; row-gap: 2rem;">
    @if (Views.Count() == 1)
    {
        var view = Views.First();

        <div class="property-panel">
            <h5>@view.QualifiedName</h5>

            <div class="property-item">
                <span class="property-title">Name</span>
                <FluentTextField Class="property-value"
                                 AutoComplete="off"
                                 Value="@view.Alias"
                                 ValueChanged="@HandleViewAliasChanged" />
                @if (!string.IsNullOrEmpty(_aliasValidationError))
                {
                    <div style="display: flex; flex-wrap: nowrap; font-size: 0.75rem; color: var(--error); gap: 0.3rem;">
                        <FluentIcon Value="@(new Icons.Filled.Size12.ErrorCircle().WithColor("var(--error)"))" />
                        <span>@_aliasValidationError</span>
                    </div>
                }
            </div>

            <div class="property-item">
                <span class="property-title">Icon</span>
                <EmojiSelectionButton Glyph="@view.HeroImage"
                                      GlyphChanged="@HandleViewEmojiChanged"
                                      Size="64"
                                      HorizontalPosition="HorizontalPosition.Left"
                                      VerticalPosition="VerticalPosition.Center"
                                      HorizontalInset="false" />
            </div>

            <div class="property-item">
                <span class="property-title">Notes</span>
                <FluentTextArea Class="property-value"
                                Rows="5"
                                Value="@view.Notes"
                                ValueChanged="@HandleViewNotesChanged" />
            </div>

            <div class="property-item">
                <span class="property-title">Space Directory</span>
                <div class="property-value" style="display: flex; flex-wrap: nowrap; align-items: center; gap: 2px;">
                    <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0;" title="@view.Space.RootDirectory">@view.Space.RootDirectory</div>
                    <FluentButton BackgroundColor="transparent" Color="transparent"
                                  Title="Copy to clipboard"
                                  Style="height: 16px; flex-shrink: 0; padding: 0; margin: 0; min-width: 16px;"
                                  OnClick="@HandlePathCopyClicked">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Copy())" />
                    </FluentButton>
                    <FluentButton BackgroundColor="transparent" Color="transparent"
                                  Title="Browse folder"
                                  Style="height: 16px; flex-shrink: 0; padding: 0; margin: 0; min-width: 16px;"
                                  OnClick="@HandleBrowseFolderClicked">
                        <FluentIcon Value="@(new Icons.Regular.Size16.FolderOpen())" />
                    </FluentButton>
                </div>
            </div>

            <div class="property-item">
                <span class="property-title">Created</span>
                <span class="property-value">
                    @view.GetMostRecentEvent(EventType.Created).Timestamp.ToString("yyyy-MM-dd HH:mm"), by 
                    <FluentBadge>
                        @view.GetMostRecentEvent(EventType.Created).Author.Name
                    </FluentBadge>
                </span>
            </div>

            <div class="property-item">
                <span class="property-title">Last modified</span>
                <span class="property-value">@view.UpdateDate.ToString("yyyy-MM-dd HH:mm"), by <FluentBadge>@view.UpdatedBy.Name</FluentBadge></span>
            </div>

            @{
                int njobs = view.Jobs.Count;
            }
            <span class="property-title">@njobs jobs</span>
        </div>
    }
    else if (Views.Count() > 1)
    {
        <h5>@Views.Count() views selected</h5>
    }

    <ActionButtons Actions="@MenuActions.GetViewActions(Views)" />
</div>