@using System.Reflection
@using Refund.DataModel
@using Refund.DataModel.ReadOnly
@using Refund.JobQueues.ReadOnly
@using Refund.Services.Core.Session
@using Refund.Utils
@using Relay.Panels.Right.JobEditor
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@if (_job != null)
{
    <div style="display: flex; flex-direction: column; width: 100%; align-items: stretch">
        <div>
            <div>
                <h5>
                    @_job.QualifiedName
                </h5>
                @if (!string.IsNullOrWhiteSpace(_job.Alias))
                {
                    <h6>
                        @_job.TypeName
                    </h6>
                }
                <div class="right-panel-compact">
                    <FluentTextField Placeholder="Custom job name"
                                     Style="width: 100%; margin-top: 10px"
                                     Value="@_job.Alias"
                                     ValueChanged="@HandleJobAliasChanged" />
                </div>
            </div>

            <JobPortDisplay Job="@_job"
                            IsDisabled="@IsFactoryInstanceSubJob"
                            GetPortErrors="@GetPortErrors"
                            OnEdgeRemoved="@HandlePortEdgeRemoved"
                            GetInternalConnections="@(IsBuilderMode ? GetInternalConnectionsForPort : null)"
                            OnInternalEdgeRemoved="@HandleInternalEdgeRemoved"
                            GetExternalConnections="@(IsBuilderMode ? GetExternalConnectionsForPort : null)"
                            OnExternalEdgeRemoved="@HandleExternalEdgeRemoved"
                            ShowExposureToggle="@IsBuilderMode"
                            IsPortExposed="@(IsBuilderMode ? IsInputPortExposed : null)"
                            OnExposureToggled="@HandleInputPortExposureToggled"
                            GetExposedPortName="@(IsBuilderMode ? GetExposedInputPortName : null)"
                            OnExposedPortNameChanged="@HandleExposedInputPortNameChanged" />
        </div>

        @if (IsBuilderMode && _job.PortsOut.Any())
        {
            <FluentDivider Style="margin: 0.5rem 0;" />
            <h6 style="margin-bottom: 0.5rem;">Output Ports</h6>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="width: 100%; margin-bottom: 0.5rem;">
                @foreach (var port in _job.PortsOut.Values)
                {
                    var _port = port;
                    var isExposed = IsOutputPortExposed(_port);
                    <div style="display: flex; align-items: center; column-gap: 8px;">
                        <div style="background-color: @(PortColors.Get(_port.ResourceType));
                                    width: 16px; height: 16px; border-radius: 8px; flex-shrink: 0;"></div>
                        @if (isExposed)
                        {
                            <FluentTextField Value="@GetExposedOutputPortName(_port)"
                                             ValueChanged="@(v => SetExposedOutputPortName(_port, v))"
                                             Placeholder="Custom name"
                                             Style="flex: 1; font-size: 0.8rem;" />
                        }
                        else
                        {
                            <span style="flex: 1; font-size: 0.85rem;">@_port.Alias</span>
                        }
                        <FluentButton BackgroundColor="transparent" Color="transparent"
                                      Style="height: 16px;"
                                      Title="@(isExposed ? "Hide from instance editor" : "Expose in instance editor")"
                                      OnClick="() => ToggleOutputPortExposure(_port, !isExposed)">
                            <FluentIcon Value="@(isExposed ? iconExposedFilled : iconExposedRegular)" />
                        </FluentButton>
                    </div>
                }
            </FluentStack>
        }

        @if (Job.TypeAdvancedParameters[_job.GetOriginalType()].Any())
        {
            <div style="justify-content: right; display: flex; margin-bottom: 6px;">
                <FluentSwitch Value="@(_userShowAdvanced.Value)"
                              ValueChanged="@(value => SetShowAdvanced(value))"
                              AriaLabel="Show advanced parameters">
                    <div style="height: 100%; display: flex; align-items: center; justify-content: center">
                        @if (_userShowAdvanced.Value)
                        {
                            <FluentEmoji Value="@(Session.ColorTheme == ColorTheme.Light ? emojiNerdFaceLight : emojiNerdFaceDark)"
                                         Width="26"/>
                        }
                        else
                        {
                            <FluentEmoji Value="@(Session.ColorTheme == ColorTheme.Light ? emojiBabyFaceLight : emojiBabyFaceDark)"
                                         Width="26"/>
                        }
                    </div>
                </FluentSwitch>
            </div>
        }

        <JobParameterDisplay Job="@_job"
                             IsDisabled="false"
                             ShowAdvanced="@(_userShowAdvanced ?? false)"
                             HideFavorites="@IsBuilderMode"
                             ShowExposureToggle="@IsBuilderMode"
                             IsPropertyExposed="@(IsBuilderMode ? IsPropertyExposed : null)"
                             OnExposureToggled="@HandleExposureToggled"
                             GetExposedPropertyName="@(IsBuilderMode ? GetExposedPropertyName : null)"
                             OnExposedPropertyNameChanged="@HandleExposedPropertyNameChanged"
                             GetError="@GetError"
                             ValueChanged="@HandleParameterChanged" />

        @if (!IsBuilderMode)
        {
            <div style="display: flex; justify-content: space-evenly;
                        column-gap: 1rem; padding: 1rem 0;">
                <FluentButton Style="width: 100%;"
                              IconStart="@(new Icons.Regular.Size20.Pause())"
                              OnClick="@(async () => await Editor.SetJob(null))">
                    Pause editing
                </FluentButton>
                @if (typeof(ILocalJob).IsAssignableFrom(_job.GetOriginalType()))
                {
                    <FluentButton Appearance="Appearance.Accent"
                                  Disabled="HasAnyValidationErrors()"
                                  IconStart="@(new Icons.Filled.Size20.Play())"
                                  Style="width: 100%;"
                                  OnClick="HandleLocalQueueSelected">
                        Run locally
                    </FluentButton>
                }
                else
                {
                    var compatibleQueues = DataManager.ClusterQueues.Where(q => (q.QueueType & _job.QueueType) != 0);

                    <ListboxButton TValue="@(ReadOnlyJobQueue)" ButtonLabel="Run"
                                   ListHeight="300"
                                   ButtonDisabled="HasAnyValidationErrors()"
                                   ButtonAppearance="Appearance.Accent"
                                   OnOptionSelected="HandleClusterQueueSelected"
                                   ListVerticalPosition="VerticalPosition.Top"
                                   IsFiltered="false"
                                   Options="@(compatibleQueues.Select(q => (q, q.QualifiedName)))"
                                   ButtonIconStart="@(new Icons.Filled.Size20.Play())"
                                   ButtonMinWidth="50" />
                }
            </div>
        }
        else
        {
            <div style="display: flex; padding: 1rem 0;">
                <FluentButton Style="width: 100%;"
                              IconStart="@(new Icons.Regular.Size20.Dismiss())"
                              OnClick="@(async () => await Editor.SetJob(null))">
                    Close
                </FluentButton>
            </div>
        }
    </div>
}
