@using Refund.Services.Core.DataManager
@using Refund.Services.Core.Session
@using Relay.Panels.Top
@using Relay.Services
@using Relay.Panels.Left
@using Relay.Panels.Right
@using Relay.Screens
@using Relay.Screens.Overlay.Job
@using Relay.Screens.Overlay.Queues
@using Relay.Screens.Overlay.Settings
@using Refund.Components
@inherits LayoutComponentBase
@inject RelaySession Session
@inject DataManager DataManager
@inject NavigationManager NavigationManager
@* Do not remove toaster! *@
@inject JobStatusToaster JobStatusToaster
@inject IHttpContextAccessor HttpContextAccessor

<main>

    @if (!_initialized)
    {
        <div class="loading-container">
            <FluentSpinner />
        </div>
    }
    else
    {
        <div class="layout-container @(_layoutClass)" style="@_containerStyle">
            @if (Session.IsAuthenticated)
            {
                <div class="top-panel" style="@_topPanelStyle">
                    @* TopBar wraps only its breadcrumbs in a boundary, so the user name, theme and panel buttons survive. *@
                    <TopBar @key="@("TopBar")" />
                </div>

                <div style="display: flex; flex-wrap: nowrap; width: 100%; height: 100%;">
                    <div class="left-panel" style="@_leftPanelStyle">
                        <RelayErrorBoundary Region="Sidebar" Compact="true">
                            <ChildContent>
                                <LeftBar @key="@("LeftBar")" />
                            </ChildContent>
                            <ErrorActions>
                                <FluentButton Size="ButtonSize.Small" OnClick="@(() => NavigationManager.NavigateTo("/process-logout", forceLoad: true))">Sign out</FluentButton>
                            </ErrorActions>
                        </RelayErrorBoundary>
                    </div>

                    <div class="center-panel" style="@_centerPanelStyle">
                        <div class="main-content">
                            @* Each region below fails on its own: the bars stay usable to navigate away. Region
                               boundaries reset on navigation (jobs and overlays don't count, so opening one
                               doesn't make a broken screen throw again). *@
                            <RelayErrorBoundary Region="This page" ResetOnNavigation="true" Style="margin: 1rem;">
                                <ChildContent>
                                    @Body
                                </ChildContent>
                                <ErrorActions>
                                    @if (Session.ProjectId != null)
                                    {
                                        <FluentButton OnClick="GoUpAsync">Up one level</FluentButton>
                                    }
                                    <FluentButton OnClick="GoHomeAsync">Home</FluentButton>
                                </ErrorActions>
                            </RelayErrorBoundary>
                        </div>

                        @if (Session.Job != null)
                        {
                            <PageTitle>
                                P@(Session.Project?.Id)/S@(Session.Space?.Id)/V@(Session.View?.Id)/@(_folderPath != null ? _folderPath + "/" : "")@(Session.Job?.QualifiedName)
                            </PageTitle>

                            <div class="overlay-content" style="z-index: 10;">
                                <RelayErrorBoundary Region="The job viewer" ResetKey="@Session.JobId" Style="margin: 1rem;">
                                    <ChildContent>
                                        <OverlayJob @key="@("OverlayJob")" />
                                    </ChildContent>
                                    <ErrorActions>
                                        <FluentButton OnClick="CloseJobAsync">Close job</FluentButton>
                                    </ErrorActions>
                                </RelayErrorBoundary>
                            </div>
                        }

                        @if (Session.CurrentOverlay != OverlayScreenType.None)
                        {
                            <div class="overlay-content" style="z-index: 10;">
                                @* The fallback needs its own Close: the overlay's close button goes down with it. *@
                                <RelayErrorBoundary Region="This screen" ResetKey="@Session.CurrentOverlay" Style="margin: 1rem;">
                                    <ChildContent>
                                @switch (Session.CurrentOverlay)
                                {
                                    case OverlayScreenType.Queues:
                                        <PageTitle>Relay: Queues</PageTitle>

                                        <OverlayQueues @key="@("OverlayQueues")" />

                                        break;

                                    case OverlayScreenType.Settings:
                                        <PageTitle>Relay: Settings</PageTitle>

                                        <OverlaySettings @key="@("OverlaySettings")" />

                                        break;

                                    case OverlayScreenType.Personal:
                                        <PageTitle>Relay: Personal</PageTitle>

                                        <Relay.Screens.Overlay.Personal.OverlayPersonal @key="@("OverlayPersonal")" />

                                        break;

                                    case OverlayScreenType.Storage:
                                        <PageTitle>Relay: Storage</PageTitle>

                                        <Relay.Screens.Overlay.Storage.OverlayStorage @key="@("OverlayStorage")" />

                                        break;
                                }
                                    </ChildContent>
                                    <ErrorActions>
                                        <FluentButton OnClick="CloseOverlayAsync">Close</FluentButton>
                                    </ErrorActions>
                                </RelayErrorBoundary>
                            </div>
                        }
                        else if (Session.Job == null && Session.Folder != null)
                        {
                            <PageTitle>P@(Session.Project?.Id)/S@(Session.Space?.Id)/V@(Session.View?.Id)/@(_folderPath)</PageTitle>
                        }
                    </div>

                    @if (Session.IsRightPanelExpanded())
                    {
                        <div class="right-panel" style="@_rightPanelStyle">
                            <RelayErrorBoundary Region="This panel" Compact="true" ResetOnNavigation="true" Style="margin: 0.5rem;">
                                <ChildContent>
                                    <RightDrawer @key="@("RightDrawer")" />
                                </ChildContent>
                                <ErrorActions>
                                    @if (JobEditor.IsActive)
                                    {
                                        @* Without this an editor that fails on its job fails again right after Retry. *@
                                        <FluentButton Size="ButtonSize.Small" OnClick="CloseEditorAsync">Close editor</FluentButton>
                                    }
                                </ErrorActions>
                            </RelayErrorBoundary>
                        </div>
                    }
                </div>
            }
            else
            {
                @Body
            }
        </div>
    }

    <FluentProviders />
</main>
