@using Refund.Services.Core.DataManager
@using Refund.Services.Core.Session
@using Relay.Panels.Top
@using Relay.Services
@using Relay.Panels.Left
@using Relay.Panels.Right
@using Relay.Screens
@using Relay.Screens.Overlay.Job
@using Relay.Screens.Overlay.Queues
@using Relay.Screens.Overlay.Settings
@inherits LayoutComponentBase
@inject RelaySession Session
@inject DataManager DataManager
@inject NavigationManager NavigationManager
@* Do not remove toaster! *@
@inject JobStatusToaster JobStatusToaster
@inject IHttpContextAccessor HttpContextAccessor

<main>
    <FluentDesignTheme Mode="@(Session.ColorTheme == ColorTheme.Light ?
                                   DesignThemeModes.Light :
                                   DesignThemeModes.Dark)" />

    @if (!_initialized)
    {
        <div class="loading-container">
            <FluentProgressRing />
        </div>
    }
    else
    {
        <div class="layout-container @(_layoutClass)" style="@_containerStyle">
            @if (Session.IsAuthenticated)
            {
                <div class="top-panel" style="@_topPanelStyle">
                    <TopBar @key="@("TopBar")" />
                </div>

                <div style="display: flex; flex-wrap: nowrap; width: 100%; height: 100%;">
                    <div class="left-panel" style="@_leftPanelStyle">
                        <LeftBar @key="@("LeftBar")" />
                    </div>

                    <div class="center-panel" style="@_centerPanelStyle">
                        <div class="main-content">
                            @Body
                        </div>

                        @if (Session.Job != null)
                        {
                            <PageTitle>
                                P@(Session.Project?.Id)/S@(Session.Space?.Id)/V@(Session.View?.Id)/@(_folderPath != null ? _folderPath + "/" : "")@(Session.Job?.QualifiedName)
                            </PageTitle>

                            <div class="overlay-content" style="z-index: 10;">
                                <OverlayJob @key="@("OverlayJob")" />
                            </div>
                        }

                        @if (Session.CurrentOverlay != OverlayScreenType.None)
                        {
                            <div class="overlay-content" style="z-index: 10;">
                                @switch (Session.CurrentOverlay)
                                {
                                    case OverlayScreenType.Queues:
                                        <PageTitle>Relay: Queues</PageTitle>

                                        <OverlayQueues @key="@("OverlayQueues")" />

                                        break;

                                    case OverlayScreenType.Settings:
                                        <PageTitle>Relay: Settings</PageTitle>

                                        <OverlaySettings @key="@("OverlaySettings")" />

                                        break;
                                }
                            </div>
                        }
                        else if (Session.Job == null && Session.Folder != null)
                        {
                            <PageTitle>P@(Session.Project?.Id)/S@(Session.Space?.Id)/V@(Session.View?.Id)/@(_folderPath)</PageTitle>
                        }
                    </div>

                    @if (Session.IsRightPanelExpanded())
                    {
                        <div class="right-panel" style="@_rightPanelStyle">
                            <RightDrawer @key="@("RightDrawer")" />
                        </div>
                    }
                </div>
            }
            else
            {
                @Body
            }
        </div>
    }

    <FluentToastProvider Timeout="10_000" Position="ToastPosition.BottomLeft" />
    <FluentDialogProvider />
    <FluentTooltipProvider />
    <FluentMessageBarProvider />
    <FluentMenuProvider />
</main>